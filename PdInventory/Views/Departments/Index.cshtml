@model List<PdInventory.Models.Department>
@{
    ViewData["Title"] = "部門";
    var pending = Model.Count(d => string.IsNullOrWhiteSpace(d.CostCenter));
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>部門 <small class="text-muted fs-6">(共 @Model.Count 個)</small></h2>
    <a class="btn btn-primary" asp-action="Create">＋ 新增部門</a>
</div>

<p class="text-muted small">
    對照欄位：SW-業務權責單位（單選）、SW-使用者帳號權限授與（多選）、
    SW-使用單位（多選）、系統自動拋轉清單-負責內部單位（單選）。
</p>

@if (pending > 0)
{
    <div class="alert alert-warning">
        有 <strong>@pending</strong> 筆沒有利潤中心代號——這些是既有資料裡出現過、
        但不在甲方部門清單中的單位，先建進來把值留住，代號待甲方補齊。它們排在清單最後。
    </div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="q" value="@ViewBag.Query" class="form-control"
               placeholder="搜尋利潤中心/部門/備註" style="min-width: 320px" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">搜尋</button>
        <a class="btn btn-outline-secondary" asp-action="Index">清除</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover table-sm align-middle pd-table">
        <thead class="table-dark">
            <tr>
                <th style="min-width: 110px">利潤中心</th>
                <th style="min-width: 260px">部門</th>
                <th style="min-width: 240px">備註</th>
                <th style="min-width: 120px" data-nosort>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td>
                        @if (string.IsNullOrWhiteSpace(d.CostCenter))
                        {
                            <span class="badge text-bg-warning">待補</span>
                        }
                        else
                        {
                            <code>@d.CostCenter</code>
                        }
                    </td>
                    <td class="text-break">@d.Name</td>
                    <td class="text-break"><small>@d.Remark</small></td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@d.Id">編輯</a>
                        <form method="post" asp-action="Delete" asp-route-id="@d.Id" class="d-inline"
                              onsubmit="return confirm('確定刪除部門「@d.Name」？');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">刪除</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
