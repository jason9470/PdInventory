@model List<PdInventory.Models.RiskCategory>
@{
    var usage = (Dictionary<string, int>)ViewBag.UsageCounts;
    ViewData["Title"] = "3-1：風險分類編號";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>3-1：風險分類編號 <small class="text-muted fs-6">(共 @Model.Count 項)</small></h2>
    <a class="btn btn-primary" asp-action="Create">＋ 新增風險分類</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="q" value="@ViewBag.Query" class="form-control"
               placeholder="搜尋編號/描述分類/風險事件" style="min-width: 320px" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">搜尋</button>
        <a class="btn btn-outline-secondary" asp-action="Index">清除</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover table-sm align-middle pd-table">
        <thead class="table-dark">
            <tr>
                <th>風險分類編號</th>
                <th>風險描述分類</th>
                <th style="min-width: 320px">潛在風險事件描述</th>
                <th style="min-width: 240px">參考之控制點</th>
                <th style="width: 110px">使用中</th>
                <th style="min-width: 120px" data-nosort>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td><code>@r.Code</code></td>
                    <td>@r.CategoryName</td>
                    <td class="text-break"><small>@r.EventDescription</small></td>
                    <td class="text-break"><small style="white-space: pre-line">@r.ControlReference</small></td>
                    @{ var used = usage.GetValueOrDefault(r.Code); }
                    <td>
                        @if (used > 0)
                        {
                            <button type="button" class="btn btn-sm btn-link p-0 align-baseline"
                                    data-usage-kind="RiskCategory" data-usage-value="@r.Code" data-usage-title="@r.Label"
                                    title="看看是哪些資料在用">
                                <span class="badge text-bg-primary">@used 筆</span>
                            </button>
                        }
                        else
                        {
                            <span class="text-muted small">未使用</span>
                        }
                    </td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@r.Id">編輯</a>
                        <form method="post" asp-action="Delete" asp-route-id="@r.Id" class="d-inline"
                              data-delete-kind="風險分類" data-delete-name="@r.Code"
                              data-delete-mode="hard">
                            @Html.AntiForgeryToken()
                            <button type="button" class="btn btn-sm btn-outline-danger" data-confirm-delete
                                    disabled="@(used > 0)"
                                    title="@(used > 0 ? "還被風險自評使用中，不能刪除" : "刪除")">刪除</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
