@model List<PdInventory.Models.RiskLikelihoodLevel>
@{
    @* 等級在字典裡以字串當鍵：明細視窗的參數是字串，兩邊用同一種寫法才不會對不上 *@
    var usage = (Dictionary<string, int>)ViewBag.UsageCounts;
    ViewData["Title"] = "3-3：評估發生可能性";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>3-3：評估發生可能性 <small class="text-muted fs-6">(共 @Model.Count 級)</small></h2>
    @if (CurrentUser.IsAdmin)
    {
        <a class="btn btn-primary" asp-action="Create">＋ 新增等級</a>
    }
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover table-sm align-middle pd-table">
        <thead class="table-dark">
            <tr>
                <th style="width: 70px">等級</th>
                <th style="width: 140px">說明</th>
                <th style="min-width: 280px">狀況描述</th>
                <th style="min-width: 280px">發生頻率</th>
                <th style="width: 110px">使用中</th>
                @if (CurrentUser.IsAdmin)
                {
                    <th style="min-width: 120px" data-nosort>操作</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td><span class="badge bg-warning text-dark fs-6">@r.Level</span></td>
                    <td class="fw-bold">@r.Name</td>
                    <td class="text-break"><small>@r.Situation</small></td>
                    <td class="text-break"><small style="white-space: pre-line">@r.Frequency</small></td>
                    @{ var used = usage.GetValueOrDefault(r.Level.ToString()); }
                    <td>
                        @if (used > 0)
                        {
                            <button type="button" class="btn btn-sm btn-link p-0 align-baseline"
                                    data-usage-kind="RiskLikelihood" data-usage-value="@r.Level" data-usage-title="@r.Label"
                                    title="看看是哪些資料在用">
                                <span class="badge text-bg-primary">@used 筆</span>
                            </button>
                        }
                        else
                        {
                            <span class="text-muted small">未使用</span>
                        }
                    </td>
                    @if (CurrentUser.IsAdmin)
                    {
                        <td>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@r.Id">編輯</a>
                            <form method="post" asp-action="Delete" asp-route-id="@r.Id" class="d-inline"
                                  data-delete-kind="發生可能性" data-delete-name="@r.Label"
                                  data-delete-mode="hard">
                                @Html.AntiForgeryToken()
                                <button type="button" class="btn btn-sm btn-outline-danger" data-confirm-delete
                                        disabled="@(used > 0)"
                                        title="@(used > 0 ? "還被風險自評使用中，不能刪除" : "刪除")">刪除</button>
                            </form>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
