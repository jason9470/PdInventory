@model PdInventory.Models.Purpose
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "新增特定目的" : $"編輯特定目的 {Model.Code}";
}

<h2>@ViewData["Title"]</h2>

<form method="post" asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.Id)" class="pd-form col-lg-8">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">
        <div class="col-md-3">
            <label asp-for="Code" class="form-label"></label>
            <input asp-for="Code" class="form-control" placeholder="例：061" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>
        <div class="col-md-9">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="例：金融監督、管理與檢查" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    </div>

    <div class="my-4">
        <button type="submit" class="btn btn-primary">@(isNew ? "新增" : "儲存")</button>
        <a class="btn btn-outline-secondary" asp-action="Index">取消</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
