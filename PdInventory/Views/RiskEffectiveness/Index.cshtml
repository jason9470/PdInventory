@model List<PdInventory.Models.RiskEffectivenessLevel>
@{
    var usage = (Dictionary<int, int>)ViewBag.UsageCounts;
    ViewData["Title"] = "3-4：有效性評估";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>3-4：有效性評估 <small class="text-muted fs-6">(共 @Model.Count 級)</small></h2>
    <a class="btn btn-primary" asp-action="Create">＋ 新增等級</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover table-sm align-middle pd-table">
        <thead class="table-dark">
            <tr>
                <th style="width: 70px">等級</th>
                <th style="width: 140px">說明</th>
                <th style="width: 140px">有效性</th>
                <th style="min-width: 320px">自行查核結果</th>
                <th style="width: 110px">使用中</th>
                <th style="min-width: 120px" data-nosort>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td><span class="badge bg-warning text-dark fs-6">@r.Level</span></td>
                    <td class="fw-bold">@r.Name</td>
                    <td>@r.Effectiveness</td>
                    <td class="text-break"><small style="white-space: pre-line">@r.CheckResult</small></td>
                    @{ var used = usage.GetValueOrDefault(r.Level); }
                    <td>
                        @if (used > 0)
                        {
                            <span class="badge text-bg-primary">@used 筆</span>
                        }
                        else
                        {
                            <span class="text-muted small">未使用</span>
                        }
                    </td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@r.Id">編輯</a>
                        <form method="post" asp-action="Delete" asp-route-id="@r.Id" class="d-inline"
                              onsubmit="return confirm('確定刪除有效性等級「@r.Label」？');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    disabled="@(used > 0)"
                                    title="@(used > 0 ? "還被風險自評使用中，不能刪除" : "刪除")">刪除</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
