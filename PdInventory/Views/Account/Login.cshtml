@model object
@using PdInventory.Models
@{
    Layout = null;
    var requiresPassword = (bool)(ViewBag.RequiresPassword ?? false);
    var knownUsers = ViewBag.KnownUsers as List<AppUser> ?? new List<AppUser>();
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>登入 - 個資盤點管理系統</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-body-tertiary">
    <div class="container" style="max-width: 560px">
        <div class="card shadow-sm mt-5">
            <div class="card-header bg-dark text-white">
                <h1 class="h5 mb-0">個資盤點管理系統</h1>
            </div>
            <div class="card-body">
                @if (TempData["Error"] is string flash)
                {
                    <div class="alert alert-danger">@flash</div>
                }
                @if (ViewBag.Error is string error)
                {
                    <div class="alert alert-danger">@error</div>
                }

                @if (!requiresPassword)
                {
                    <p class="text-muted small">
                        目前是<strong>模擬登入</strong>模式，不會驗證密碼，僅供權限測試使用。
                        正式環境請將 appsettings 的 <code>Employee:Mode</code> 設為 <code>Ldap</code>，
                        帳號密碼將改由公司 AD 驗證。
                    </p>
                }

                <form method="post" class="mb-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    <div class="mb-3">
                        <label class="form-label" for="account">帳號</label>
                        <input id="account" name="account" class="form-control" required
                               autocomplete="username" autofocus
                               placeholder="員工編號，例如 183253" />
                    </div>
                    @if (requiresPassword)
                    {
                        <div class="mb-3">
                            <label class="form-label" for="password">密碼</label>
                            <input id="password" name="password" type="password" class="form-control"
                                   required autocomplete="current-password" />
                            <div class="form-text">與您登入公司電腦的網域密碼相同。</div>
                        </div>
                    }
                    else
                    {
                        @* 模擬模式沒有 AD 可問姓名，但姓名是人員表建檔的必要資訊，
                           這裡補一格才能在沒有 AD 的環境驗證「第一次登入自動建檔」 *@
                        <div class="mb-3">
                            <label class="form-label" for="displayName">姓名</label>
                            <input id="displayName" name="displayName" class="form-control"
                                   placeholder="第一次登入的新帳號才需要填" />
                            <div class="form-text">
                                模擬模式專用。正式環境的姓名由公司 AD 提供，不會顯示這一格。
                            </div>
                        </div>
                    }
                    <button type="submit" class="btn btn-primary w-100">登入</button>
                </form>

                @if (!requiresPassword && knownUsers.Count > 0)
                {
                    <hr />
                    <div class="small text-muted mb-2">或直接點選已建檔的帳號：</div>
                    <div class="list-group list-group-flush small">
                        @foreach (var user in knownUsers)
                        {
                            <form method="post" class="list-group-item list-group-item-action d-flex
                                                        justify-content-between align-items-center py-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="account" value="@user.EmpNo" />
                                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                                <span>
                                    <span class="pd-code">@user.EmpNo</span>
                                    <span class="ms-2">@user.EmpName</span>
                                </span>
                                <span>
                                    <span class="badge text-bg-secondary me-2">
                                        @PdInventory.Helpers.RoleDisplay.Name(user.Role)
                                    </span>
                                    <button type="submit" class="btn btn-sm btn-outline-primary">登入</button>
                                </span>
                            </form>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</body>
</html>
