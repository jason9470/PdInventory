@model object
@using PdInventory.Models
@{
    Layout = null;
    var isSimulated = (bool)(ViewBag.IsSimulated ?? true);
    var knownUsers = ViewBag.KnownUsers as List<AppUser> ?? new List<AppUser>();
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>登入 - 個資盤點管理系統</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-body-tertiary">
    <div class="container" style="max-width: 560px">
        <div class="card shadow-sm mt-5">
            <div class="card-header bg-dark text-white">
                <h1 class="h5 mb-0">個資盤點管理系統</h1>
            </div>
            <div class="card-body">
                @if (TempData["Error"] is string flash)
                {
                    <div class="alert alert-danger">@flash</div>
                }
                @if (ViewBag.Error is string error)
                {
                    <div class="alert alert-danger">@error</div>
                }

                @if (isSimulated)
                {
                    <p class="text-muted small">
                        目前是<strong>模擬登入</strong>模式，供權限測試使用。
                        正式環境請將 appsettings 的 <code>Employee:Mode</code> 設為 <code>Remote</code>，
                        身分將改由公司身分服務判定，不會出現這個畫面。
                    </p>

                    <form method="post" class="row g-2 align-items-end mb-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                        <div class="col">
                            <label class="form-label small" for="empNo">員工編號</label>
                            <input id="empNo" name="empNo" class="form-control" required
                                   placeholder="例如 0183253" />
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary">登入</button>
                        </div>
                    </form>

                    @if (knownUsers.Count > 0)
                    {
                        <hr />
                        <div class="small text-muted mb-2">或直接點選已建檔的帳號：</div>
                        <div class="list-group list-group-flush small">
                            @foreach (var user in knownUsers)
                            {
                                <form method="post" class="list-group-item list-group-item-action d-flex
                                                            justify-content-between align-items-center py-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="empNo" value="@user.EmpNo" />
                                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                                    <span>
                                        <span class="pd-code">@user.EmpNo</span>
                                        <span class="ms-2">@user.EmpName</span>
                                    </span>
                                    <span>
                                        <span class="badge text-bg-secondary me-2">
                                            @PdInventory.Helpers.RoleDisplay.Name(user.Role)
                                        </span>
                                        <button type="submit" class="btn btn-sm btn-outline-primary">登入</button>
                                    </span>
                                </form>
                            }
                        </div>
                    }
                }
                else
                {
                    <p>系統會自動辨識您的身分，若停在這個畫面請重新整理。</p>
                    <form method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="empNo" value="" />
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                        <button type="submit" class="btn btn-primary">重新嘗試登入</button>
                    </form>
                }
            </div>
        </div>
    </div>
</body>
</html>
