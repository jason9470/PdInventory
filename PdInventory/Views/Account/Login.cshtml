@model object
@using PdInventory.Models
@{
    Layout = null;
    var requiresPassword = (bool)(ViewBag.RequiresPassword ?? false);
    var knownUsers = ViewBag.KnownUsers as List<AppUser> ?? new List<AppUser>();
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>登入 - 個資盤點管理系統</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-body-tertiary">
    <div class="container" style="max-width: 560px">
        <div class="card shadow-sm mt-5">
            <div class="card-header bg-dark text-white">
                <h1 class="h5 mb-0">個資盤點管理系統</h1>
            </div>
            <div class="card-body">
                @if (TempData["Error"] is string flash)
                {
                    <div class="alert alert-danger">@flash</div>
                }
                @if (ViewBag.Error is string error)
                {
                    <div class="alert alert-danger">@error</div>
                }

                @if (!requiresPassword)
                {
                    <div class="alert alert-warning small mb-3">
                        <strong>AD 密碼驗證暫停中</strong>，測試期間<strong>只要輸入帳號就能登入</strong>。
                        要恢復請把 appsettings 的 <code>Employee:Mode</code> 改回 <code>Ldap</code>，
                        密碼欄就會啟用、改由公司 AD 驗證。
                    </div>
                }

                <form method="post" class="mb-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    <div class="mb-3">
                        <label class="form-label" for="account">帳號</label>
                        <input id="account" name="account" class="form-control" required
                               autocomplete="off" autofocus list="knownAccounts"
                               placeholder="員工編號，例如 0183253" />
                        @if (!requiresPassword && knownUsers.Count > 0)
                        {
                            @* 已建檔的帳號做成建議清單：133 筆列成按鈕會變成一面牆，
                               打字或下拉挑都可以，比較好測 *@
                            <datalist id="knownAccounts">
                                @foreach (var user in knownUsers)
                                {
                                    <option value="@user.EmpNo">@user.EmpName（@PdInventory.Helpers.RoleDisplay.Name(user.Role)）</option>
                                }
                            </datalist>
                            <div class="form-text">共 @knownUsers.Count 個已建檔的帳號，可直接輸入或從清單挑選。</div>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="password">密碼</label>
                        @* 暫停期間刻意保留這一格但停用，讓使用者看得出來「之後會用到」，
                           而不是以為系統本來就不需要密碼。disabled 的欄位不會送出。 *@
                        <input id="password" name="password" type="password" class="form-control"
                               required="@requiresPassword" disabled="@(!requiresPassword)"
                               autocomplete="current-password" />
                        <div class="form-text">
                            @if (requiresPassword)
                            {
                                <text>與您登入公司電腦的網域密碼相同。</text>
                            }
                            else
                            {
                                <text>AD 驗證暫停中，這一格暫時停用，不必填。</text>
                            }
                        </div>
                    </div>
                    @if (!requiresPassword)
                    {
                        @* 姓名只有「名冊裡還沒有這個人」時才用得到，平常留空即可 *@
                        <div class="mb-3">
                            <label class="form-label" for="displayName">姓名<span class="text-muted">（選填）</span></label>
                            <input id="displayName" name="displayName" class="form-control"
                                   placeholder="名冊裡還沒有的新帳號才需要填" />
                        </div>
                    }
                    <button type="submit" class="btn btn-primary w-100">登入</button>
                </form>

            </div>
        </div>
    </div>
</body>
</html>
