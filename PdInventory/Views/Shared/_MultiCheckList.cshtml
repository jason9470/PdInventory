@model PdInventory.Models.ViewModels.MultiCheckListModel
@*
    多選欄位的勾選清單。真正送出的是下面那個 hidden input（值以 / 分隔），
    勾選由 site.js 同步進去；沒有 JavaScript 時原值仍會原封不動送回，不會被清空。
*@
<div class="pd-multicheck" data-target="@Model.ElementId">
    <input type="hidden" id="@Model.ElementId" name="@Model.FieldName" value="@Model.Value" />

    <div class="pd-multicheck-box">
        @foreach (var value in Model.Unknown)
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox" checked
                       id="@(Model.ElementId)__x@(Model.Unknown.IndexOf(value))" value="@value" />
                <label class="form-check-label text-warning-emphasis"
                       for="@(Model.ElementId)__x@(Model.Unknown.IndexOf(value))">
                    @value <span class="badge text-bg-warning">不在選項中</span>
                </label>
            </div>
        }
        @for (var i = 0; i < Model.Options.Count; i++)
        {
            var value = Model.Options[i];
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="@(Model.ElementId)__@i"
                       value="@value" checked="@Model.Selected.Contains(value)" />
                <label class="form-check-label" for="@(Model.ElementId)__@i">@value</label>
            </div>
        }
    </div>

    @if (Model.AllowCustom)
    {
        @* 清單以外的值（例如委外廠商）直接打進來。業務端決定這類名稱不回寫維護表，
           所以這裡只是把它加成一個勾好的項目，存進欄位而已。 *@
        <div class="input-group input-group-sm mt-1 pd-multicheck-custom">
            <input type="text" class="form-control" placeholder="清單裡沒有的（例如委外廠商）自行輸入" />
            <button type="button" class="btn btn-outline-secondary">加入</button>
        </div>
    }

    <div class="form-text pd-multicheck-summary"></div>
</div>
