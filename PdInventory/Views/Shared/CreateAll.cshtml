@model PdInventory.Models.ViewModels.InfoSystemEditViewModel
@using PdInventory.Models.ViewModels
@{
    ViewData["Title"] = "新增資訊資產";
    // 從哪張清單按的[新增]，決定[取消]與新增完成後回到哪裡
    var from = (string)(ViewBag.From ?? PdInventory.Helpers.ListSource.Default);
}

@*
    SW / DA / 系統盤點 三個區塊的統一新增畫面。

    與[編輯]畫面不同的是：這裡只有一個[新增]按鈕。三個區塊同屬一筆尚未存在的
    InfoSystem，若比照編輯拆成三個各自儲存，第一次儲存會建出一筆、第二次又建一筆，
    變成三筆殘缺資料。所以新增一律整筆一起送出。

    「編號／資產編號／資產名稱」是必填的識別欄位，放在最前面先填。
*@

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@ViewData["Title"]</h2>
    <a class="btn btn-outline-secondary" asp-controller="@from" asp-action="Index" asp-route-clear="1">取消</a>
</div>

<form method="post" class="pd-form" asp-controller="Data" asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" name="from" value="@from" />

    <div class="card mb-3">
        <div class="card-header fw-bold">基本資訊</div>
        <div class="card-body row g-3">
            @* 編號已停用（甲方 0910：以後不會再有編號），欄位保留是為了既有資料，
               新資料一律空白。它沒有資料庫唯一索引，空白不會撞號。 *@
            <input asp-for="Software.SeqNo" type="hidden" />
            <div class="col-md-2">
                <div class="form-check mt-4 pt-2">
                    <input asp-for="NoSoftwareAsset" class="form-check-input" id="noSoftwareAsset" />
                    <label class="form-check-label fw-bold" for="noSoftwareAsset">無SW資產編號</label>
                </div>
            </div>
            <div class="col-md-3 pd-sw-only">
                <label asp-for="Software.SystemCode" class="form-label"></label>
                <input asp-for="Software.SystemCode" class="form-control" placeholder="例：SW-108" />
                <span asp-validation-for="Software.SystemCode" class="text-danger"></span>
            </div>
            <div class="col-md-7 pd-sw-only">
                <label asp-for="Software.SystemName" class="form-label"></label>
                <input asp-for="Software.SystemName" class="form-control" placeholder="例：經紀帳務系統" />
                <span asp-validation-for="Software.SystemName" class="text-danger"></span>
            </div>
        </div>
    </div>

    @* 勾了「無SW資產編號」時，這個區塊與盤點表區塊由 site.js 整塊隱藏並停用其中的欄位。
       停用是關鍵：只隱藏的話欄位照樣會送出，後端會誤以為使用者填了 SW。
       但停用只是操作防呆，DataController.Create 收到勾選時一律把兩個區塊的內容丟掉。 *@
    <div class="card mb-3 pd-sw-only">
        <div class="card-header fw-bold bg-primary text-white">資訊資產清單－軟體(SW)</div>
        <div class="card-body row g-3">
            <div class="col-md-3"><label asp-for="Software.SwStatus" class="form-label"></label><select asp-for="Software.SwStatus" class="form-select"
                    asp-items="Lookup.OptionItemsFor(nameof(InfoSystem.SwStatus), Model.Software.SwStatus)">
                <option value="">-- 請選擇 --</option>
            </select></div>
            <div class="col-md-3"><label asp-for="Software.SwAssetType" class="form-label"></label><select asp-for="Software.SwAssetType" class="form-select"
                    asp-items="FieldOptions.ItemsFor(nameof(InfoSystem.SwAssetType), Model.Software.SwAssetType)">
                <option value="">-- 請選擇 --</option>
            </select></div>
            <div class="col-md-3"><label asp-for="Software.SwSystemCategory" class="form-label"></label><select asp-for="Software.SwSystemCategory" class="form-select sw-system-category"
                    asp-items="Lookup.OptionItemsFor(nameof(InfoSystem.SwSystemCategory), Model.Software.SwSystemCategory)">
                <option value="">-- 請選擇 --</option>
            </select></div>
            <div class="col-md-3"><label asp-for="Software.SwAdIntegration" class="form-label"></label><select asp-for="Software.SwAdIntegration" class="form-select"
                    asp-items="Lookup.OptionItemsFor(nameof(InfoSystem.SwAdIntegration), Model.Software.SwAdIntegration)">
                <option value="">-- 請選擇 --</option>
            </select></div>
            <div class="col-md-12"><label asp-for="Software.SwDescription" class="form-label"></label>
                <textarea asp-for="Software.SwDescription" class="form-control" rows="3"
                          placeholder="使用部門、使用人員、主要功能"></textarea></div>
            <div class="col-md-3"><label asp-for="Software.SwOsVersion" class="form-label"></label><input asp-for="Software.SwOsVersion" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwDbToolVersion" class="form-label"></label><input asp-for="Software.SwDbToolVersion" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwThirdPartyComponents" class="form-label"></label><select asp-for="Software.SwThirdPartyComponents" class="form-select"
                    asp-items="Lookup.OptionItemsFor(nameof(InfoSystem.SwThirdPartyComponents), Model.Software.SwThirdPartyComponents)">
                <option value="">-- 請選擇 --</option>
            </select></div>
            <div class="col-md-3"><label asp-for="Software.SwUserAccountGrant" class="form-label"></label>
