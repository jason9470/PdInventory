        <div class="card-header fw-bold bg-info text-white">資訊系統／資料庫／伺服器盤點表</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12"><h6 class="text-muted border-bottom pb-1 mb-0">I. 系統基本資訊</h6></div>
                <div class="col-md-12">
                    <label asp-for="Sheet3.DbName" class="form-label"></label>
                    <input asp-for="Sheet3.DbName" class="form-control"
                           placeholder="例：Oracle DB Server：FEDB" />
                </div>

                <div class="col-12 mt-4"><h6 class="text-muted border-bottom pb-1 mb-0">II. 備份</h6></div>
                <div class="col-md-6">
                    <label asp-for="Sheet3.BackupLocation" class="form-label"></label>
                    <textarea asp-for="Sheet3.BackupLocation" class="form-control" rows="2"
                              placeholder="例：同地:信義機房 異地:板橋機房"></textarea>
                </div>
                <div class="col-md-6">
                    <label asp-for="Sheet3.BackupCycle" class="form-label"></label>
                    <textarea asp-for="Sheet3.BackupCycle" class="form-control" rows="3"
                              placeholder="例：每天、每週"></textarea>
                </div>

                <div class="col-12 mt-4">
                    <h6 class="text-muted border-bottom pb-1 mb-0">
                        III. 外部單位存取權限盤點 <small>（無外部存取則填 N/A）</small>
                    </h6>
                </div>
                <div class="col-md-3">
                    <label asp-for="Sheet3.ExternalUnitName" class="form-label"></label>
                    <input asp-for="Sheet3.ExternalUnitName" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Sheet3.HasLog" class="form-label"></label>
                    <select asp-for="Sheet3.HasLog" class="form-select">
                        <option value="">請選擇</option>
                        <option>Y</option>
                        <option>N</option>
                        <option>N/A</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="Sheet3.AccessCreate" class="form-label"></label>
                    <input asp-for="Sheet3.AccessCreate" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Sheet3.AccessDelete" class="form-label"></label>
                    <input asp-for="Sheet3.AccessDelete" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Sheet3.AccessCopy" class="form-label"></label>
                    <input asp-for="Sheet3.AccessCopy" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Sheet3.FileDescription" class="form-label"></label>
                    <input asp-for="Sheet3.FileDescription" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Sheet3.SpecialData" class="form-label"></label>
                    <input asp-for="Sheet3.SpecialData" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Sheet3.SubjectCount" class="form-label"></label>
                    <input asp-for="Sheet3.SubjectCount" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Sheet3.RetentionPeriod" class="form-label"></label>
                    <input asp-for="Sheet3.RetentionPeriod" class="form-control" />
                </div>

                <div class="col-12 mt-4"><h6 class="text-muted border-bottom pb-1 mb-0">IV. 備註</h6></div>
                <div class="col-12">
                    <textarea asp-for="Sheet3.Remark" class="form-control" rows="2"></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <button type="submit" class="btn btn-primary">新增</button>
        <a class="btn btn-outline-secondary" asp-controller="@from" asp-action="Index" asp-route-clear="1">取消</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
