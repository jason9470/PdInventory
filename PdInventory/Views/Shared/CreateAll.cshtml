@model PdInventory.Models.ViewModels.InfoSystemEditViewModel
@{
    ViewData["Title"] = "新增資訊資產";
    // 從哪張清單按的[新增]，決定[取消]與新增完成後回到哪裡
    var from = (string)(ViewBag.From ?? PdInventory.Helpers.ListSource.Default);
}

@*
    SW / DA / 系統盤點 三個區塊的統一新增畫面。

    與[編輯]畫面不同的是：這裡只有一個[新增]按鈕。三個區塊同屬一筆尚未存在的
    InfoSystem，若比照編輯拆成三個各自儲存，第一次儲存會建出一筆、第二次又建一筆，
    變成三筆殘缺資料。所以新增一律整筆一起送出。

    「編號／資產編號／資產名稱」是必填的識別欄位，放在最前面先填。
*@

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@ViewData["Title"]</h2>
    <a class="btn btn-outline-secondary" asp-controller="@from" asp-action="Index" asp-route-clear="1">取消</a>
</div>

<form method="post" class="pd-form" asp-controller="Systems" asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" name="from" value="@from" />

    <div class="card mb-3">
        <div class="card-header fw-bold">基本資訊</div>
        <div class="card-body row g-3">
            <div class="col-md-2">
                <label asp-for="Sheet3.SeqNo" class="form-label"></label>
                <input asp-for="Sheet3.SeqNo" class="form-control" />
                <span asp-validation-for="Sheet3.SeqNo" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Sheet3.SystemCode" class="form-label"></label>
                <input asp-for="Sheet3.SystemCode" class="form-control" placeholder="例：SW-108" />
                <span asp-validation-for="Sheet3.SystemCode" class="text-danger"></span>
            </div>
            <div class="col-md-7">
                <label asp-for="Sheet3.SystemName" class="form-label"></label>
                <input asp-for="Sheet3.SystemName" class="form-control" placeholder="例：經紀帳務系統" />
                <span asp-validation-for="Sheet3.SystemName" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header fw-bold bg-primary text-white">資訊資產清單－軟體(SW)</div>
        <div class="card-body row g-3">
            <div class="col-md-3"><label asp-for="Software.SwStatus" class="form-label"></label><input asp-for="Software.SwStatus" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwAssetType" class="form-label"></label><input asp-for="Software.SwAssetType" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwSystemCategory" class="form-label"></label><input asp-for="Software.SwSystemCategory" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwAdIntegration" class="form-label"></label><input asp-for="Software.SwAdIntegration" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwOsVersion" class="form-label"></label><input asp-for="Software.SwOsVersion" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwDbToolVersion" class="form-label"></label><input asp-for="Software.SwDbToolVersion" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="Software.SwThirdPartyComponents" class="form-label"></label><input asp-for="Software.SwThirdPartyComponents" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwUserAccountGrant" class="form-label"></label><input asp-for="Software.SwUserAccountGrant" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwProvidesAccountReport" class="form-label"></label><input asp-for="Software.SwProvidesAccountReport" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwRiskOwner" class="form-label"></label><input asp-for="Software.SwRiskOwner" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwLocation" class="form-label"></label><input asp-for="Software.SwLocation" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwOwnerUnit" class="form-label"></label><input asp-for="Software.SwOwnerUnit" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwCustodianUnit" class="form-label"></label><input asp-for="Software.SwCustodianUnit" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="Software.SwUserUnit" class="form-label"></label><input asp-for="Software.SwUserUnit" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwConfidentiality" class="form-label"></label><input asp-for="Software.SwConfidentiality" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwIntegrity" class="form-label"></label><input asp-for="Software.SwIntegrity" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwAvailability" class="form-label"></label><input asp-for="Software.SwAvailability" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwAssetValue" class="form-label"></label><input asp-for="Software.SwAssetValue" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwBusinessContact" class="form-label"></label><input asp-for="Software.SwBusinessContact" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwAppManager" class="form-label"></label><input asp-for="Software.SwAppManager" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwAppMaintainer" class="form-label"></label><input asp-for="Software.SwAppMaintainer" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwAppMaintainerDeputy" class="form-label"></label><input asp-for="Software.SwAppMaintainerDeputy" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="Software.SwOperator" class="form-label"></label><input asp-for="Software.SwOperator" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwDevMode" class="form-label"></label><input asp-for="Software.SwDevMode" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwMaintMode" class="form-label"></label><input asp-for="Software.SwMaintMode" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwVendor" class="form-label"></label><input asp-for="Software.SwVendor" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwLanguage" class="form-label"></label><input asp-for="Software.SwLanguage" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwVersionControl" class="form-label"></label><input asp-for="Software.SwVersionControl" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwApRepoPath" class="form-label"></label><input asp-for="Software.SwApRepoPath" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwDeployMethod" class="form-label"></label><input asp-for="Software.SwDeployMethod" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwOpRepoPath" class="form-label"></label><input asp-for="Software.SwOpRepoPath" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwCodeAccess" class="form-label"></label><input asp-for="Software.SwCodeAccess" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwDeveloper" class="form-label"></label><input asp-for="Software.SwDeveloper" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwDeployer" class="form-label"></label><input asp-for="Software.SwDeployer" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwRpo" class="form-label"></label><input asp-for="Software.SwRpo" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwLocalBackup" class="form-label"></label><input asp-for="Software.SwLocalBackup" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwLocalBackupType" class="form-label"></label><input asp-for="Software.SwLocalBackupType" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwLocalBackupFreq" class="form-label"></label><input asp-for="Software.SwLocalBackupFreq" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwRemoteBackup" class="form-label"></label><input asp-for="Software.SwRemoteBackup" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwRemoteBackupType" class="form-label"></label><input asp-for="Software.SwRemoteBackupType" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwRemoteBackupFreq" class="form-label"></label><input asp-for="Software.SwRemoteBackupFreq" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwLocalHa" class="form-label"></label><input asp-for="Software.SwLocalHa" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwLocalHaArch" class="form-label"></label><input asp-for="Software.SwLocalHaArch" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwRemoteHa" class="form-label"></label><input asp-for="Software.SwRemoteHa" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwRemoteHaArch" class="form-label"></label><input asp-for="Software.SwRemoteHaArch" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwRto" class="form-label"></label><input asp-for="Software.SwRto" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwHasRecoveryPlan" class="form-label"></label><input asp-for="Software.SwHasRecoveryPlan" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwHasDrDrill" class="form-label"></label><input asp-for="Software.SwHasDrDrill" class="form-control" /></div>
            <div class="col-12"><label asp-for="Software.SwRelatedSystems" class="form-label"></label><textarea asp-for="Software.SwRelatedSystems" class="form-control" rows="3"></textarea></div>
            <div class="col-md-3"><label asp-for="Software.SwHandlesPersonalData" class="form-label"></label><input asp-for="Software.SwHandlesPersonalData" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwHasUiAuth" class="form-label"></label><input asp-for="Software.SwHasUiAuth" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwKeepsPdTrail" class="form-label"></label><input asp-for="Software.SwKeepsPdTrail" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwProvidesApi" class="form-label"></label><input asp-for="Software.SwProvidesApi" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="Software.SwTrailLocation" class="form-label"></label><input asp-for="Software.SwTrailLocation" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwTrailStorage" class="form-label"></label><input asp-for="Software.SwTrailStorage" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwBusinessOwnerUnit" class="form-label"></label><input asp-for="Software.SwBusinessOwnerUnit" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwIsCoreSystem" class="form-label"></label><input asp-for="Software.SwIsCoreSystem" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwReviewer" class="form-label"></label><input asp-for="Software.SwReviewer" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwModifiedBy" class="form-label"></label><input asp-for="Software.SwModifiedBy" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Software.SwModifiedTime" class="form-label"></label><input asp-for="Software.SwModifiedTime" class="form-control" /></div>
            <div class="col-12"><label asp-for="Software.SwRemark" class="form-label"></label><textarea asp-for="Software.SwRemark" class="form-control" rows="2"></textarea></div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header fw-bold bg-success text-white">資訊資產清單－資料(DA)</div>
        <div class="card-body row g-3">
            <div class="col-md-4"><label asp-for="Data.DaAssetCode" class="form-label"></label><input asp-for="Data.DaAssetCode" class="form-control" placeholder="例：DA-119" /></div>
            <div class="col-md-4"><label asp-for="Data.DaAssetType" class="form-label"></label><input asp-for="Data.DaAssetType" class="form-control" /></div>
            <div class="col-md-4"><label asp-for="Data.DaStatus" class="form-label"></label><input asp-for="Data.DaStatus" class="form-control" /></div>
            <div class="col-12"><label asp-for="Data.DaDescription" class="form-label">資產說明</label><textarea asp-for="Data.DaDescription" class="form-control" rows="2"></textarea></div>
            <div class="col-md-4"><label asp-for="Data.DaBackupMethod" class="form-label"></label><input asp-for="Data.DaBackupMethod" class="form-control" /></div>
            <div class="col-md-4"><label asp-for="Data.DaRetentionPeriod" class="form-label"></label><input asp-for="Data.DaRetentionPeriod" class="form-control" /></div>
            <div class="col-md-4"><label asp-for="Data.DaHasSensitiveData" class="form-label"></label><input asp-for="Data.DaHasSensitiveData" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Data.DaRiskOwner" class="form-label"></label><input asp-for="Data.DaRiskOwner" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Data.DaLocation" class="form-label"></label><input asp-for="Data.DaLocation" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Data.DaOwnerUnit" class="form-label"></label><input asp-for="Data.DaOwnerUnit" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Data.DaCustodianUnit" class="form-label"></label><input asp-for="Data.DaCustodianUnit" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="Data.DaUserUnit" class="form-label"></label><input asp-for="Data.DaUserUnit" class="form-control" /></div>
            <div class="col-md-2"><label asp-for="Data.DaConfidentiality" class="form-label"></label><input asp-for="Data.DaConfidentiality" class="form-control" /></div>
            <div class="col-md-2"><label asp-for="Data.DaIntegrity" class="form-label"></label><input asp-for="Data.DaIntegrity" class="form-control" /></div>
            <div class="col-md-2"><label asp-for="Data.DaAvailability" class="form-label"></label><input asp-for="Data.DaAvailability" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Data.DaAssetValue" class="form-label"></label><input asp-for="Data.DaAssetValue" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="Data.DaBackupConfirm" class="form-label"></label><input asp-for="Data.DaBackupConfirm" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Data.DaReviewer" class="form-label"></label><input asp-for="Data.DaReviewer" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Data.DaModifiedTime" class="form-label"></label><input asp-for="Data.DaModifiedTime" class="form-control" /></div>
            <div class="col-12"><label asp-for="Data.DaRemark" class="form-label"></label><textarea asp-for="Data.DaRemark" class="form-control" rows="2"></textarea></div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header fw-bold">資訊系統／資料庫／伺服器盤點表</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12"><h6 class="text-muted border-bottom pb-1 mb-0">I. 系統基本資訊</h6></div>
                <div class="col-md-6">
                    <label asp-for="Sheet3.Description" class="form-label"></label>
                    <textarea asp-for="Sheet3.Description" class="form-control" rows="4"
                              placeholder="使用部門、使用人員、主要功能"></textarea>
                </div>
                <div class="col-md-6">
                    <label asp-for="Sheet3.DbName" class="form-label"></label>
                    <textarea asp-for="Sheet3.DbName" class="form-control" rows="4"
                              placeholder="例：Oracle DB Server：FEDB"></textarea>
                </div>

                <div class="col-12 mt-4"><h6 class="text-muted border-bottom pb-1 mb-0">II. 備份</h6></div>
                <div class="col-md-6">
                    <label asp-for="Sheet3.BackupLocation" class="form-label"></label>
                    <textarea asp-for="Sheet3.BackupLocation" class="form-control" rows="2"
                              placeholder="例：同地:信義機房 異地:板橋機房"></textarea>
                </div>
                <div class="col-md-6">
                    <label asp-for="Sheet3.BackupCycle" class="form-label"></label>
                    <input asp-for="Sheet3.BackupCycle" class="form-control" placeholder="例：每天、每週" />
                </div>

                <div class="col-12 mt-4">
                    <h6 class="text-muted border-bottom pb-1 mb-0">
                        III. 外部單位存取權限盤點 <small>（無外部存取則填 N/A）</small>
                    </h6>
                </div>
                <div class="col-md-4">
                    <label asp-for="Sheet3.ExternalUnitName" class="form-label"></label>
                    <input asp-for="Sheet3.ExternalUnitName" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="Sheet3.HasLog" class="form-label"></label>
                    <select asp-for="Sheet3.HasLog" class="form-select">
                        <option value="">請選擇</option>
                        <option>Y</option>
                        <option>N</option>
                        <option>N/A</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label asp-for="Sheet3.AccessCreate" class="form-label"></label>
                    <input asp-for="Sheet3.AccessCreate" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="Sheet3.AccessDelete" class="form-label"></label>
                    <input asp-for="Sheet3.AccessDelete" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="Sheet3.AccessCopy" class="form-label"></label>
                    <input asp-for="Sheet3.AccessCopy" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Sheet3.FileDescription" class="form-label"></label>
                    <input asp-for="Sheet3.FileDescription" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="Sheet3.SpecialData" class="form-label"></label>
                    <input asp-for="Sheet3.SpecialData" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="Sheet3.SubjectCount" class="form-label"></label>
                    <input asp-for="Sheet3.SubjectCount" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="Sheet3.RetentionPeriod" class="form-label"></label>
                    <input asp-for="Sheet3.RetentionPeriod" class="form-control" />
                </div>

                <div class="col-12 mt-4"><h6 class="text-muted border-bottom pb-1 mb-0">IV. 備註</h6></div>
                <div class="col-12">
                    <textarea asp-for="Sheet3.Remark" class="form-control" rows="2"></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <button type="submit" class="btn btn-primary">新增</button>
        <a class="btn btn-outline-secondary" asp-controller="@from" asp-action="Index" asp-route-clear="1">取消</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
