@model PdInventory.Models.ViewModels.InfoSystemEditViewModel
@using PdInventory.Models.ViewModels
@{
    ViewData["Title"] = $"編輯 {Model.Asset.SystemCode} {Model.Asset.SystemName}";
    // 從哪張清單進來的；三個區塊都要把它帶進 POST，存檔後導回本頁時才不會遺失
    var from = (string)(ViewBag.From ?? PdInventory.Helpers.ListSource.Default);
}

@*
    SW / DA / 系統盤點 三個區塊的統一編輯畫面（對應 Systems/Details 的呈現方式）。
    每個區塊各自是一個 <form>，各自 POST 到原本的控制器，因此[儲存]只寫入該區塊的欄位。

    每個區塊繫結自己的 ViewModel，欄位名稱以 Software. / Data. / Sheet3. 前綴區隔，
    因此三個 form 不會產生重複的 DOM id，送出的內容也只可能屬於該區塊。

    共用欄位（編號／資產編號／資產名稱）只屬於「系統基本資訊」區塊，
    SW 與 DA 的 ViewModel 根本沒有這些屬性，不可能互相覆蓋。
*@

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>編輯：@Model.Asset.SeqNo @Model.Asset.SystemCode @Model.Asset.SystemName</h2>
    <div>
        <a class="btn btn-outline-info" asp-controller="Software" asp-action="Details"
           asp-route-id="@Model.Asset.Id" asp-route-from="@from">檢視</a>
        <a class="btn btn-outline-secondary" asp-controller="@from" asp-action="Index" asp-route-clear="1">取消</a>
    </div>
</div>

<p class="text-muted small">三個區塊各自獨立儲存，按下區塊下方的[儲存]只會寫入該區塊的欄位。</p>

