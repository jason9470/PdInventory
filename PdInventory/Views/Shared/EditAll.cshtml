    </div>
</form>

@* ──────────────────── 資訊系統、資料庫與檔案伺服器盤點表 ──────────────────── *@
<form method="post" class="pd-form" asp-controller="Systems" asp-action="Edit" asp-route-id="@Model.Asset.Id">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" name="Sheet3.Id" value="@Model.Asset.Id" />
    <input type="hidden" name="from" value="@from" />
    @* 並行控制：帶回載入當下的權杖，存檔時比對是否已被他人改過 *@
    <input type="hidden" name="Sheet3.RowVersion" value="@Model.Asset.RowVersion" />

    <div class="card mb-3">
        <div class="card-header fw-bold bg-info text-white">資訊系統／資料庫／伺服器盤點表</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12"><h6 class="text-muted border-bottom pb-1 mb-0">I. 系統基本資訊</h6>
                    @* 這四個欄位版面上在盤點表這張卡，資料卻屬於 SW。用 HTML 的 form 屬性
                       掛回上面那張 SW 表單，按盤點表的[儲存]不會動到它們，按 SW 的[儲存]才會。 *@
                    <div class="form-text">編號、資產編號、資產名稱、資產說明屬於上方的 SW 區塊，請按 SW 的[儲存]。</div>
                </div>
                <div class="col-md-2">
                    <label asp-for="Software.SeqNo" class="form-label"></label>
                    <input asp-for="Software.SeqNo" class="form-control" form="swBlockForm" />
                    <span asp-validation-for="Software.SeqNo" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Software.SystemCode" class="form-label"></label>
                    <input asp-for="Software.SystemCode" class="form-control" placeholder="例：SW-108" form="swBlockForm" />
                    <span asp-validation-for="Software.SystemCode" class="text-danger"></span>
                </div>
                <div class="col-md-7">
                    <label asp-for="Software.SystemName" class="form-label"></label>
                    <input asp-for="Software.SystemName" class="form-control" placeholder="例：經紀帳務系統" form="swBlockForm" />
                    <span asp-validation-for="Software.SystemName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Software.Description" class="form-label"></label>
                    <textarea asp-for="Software.Description" class="form-control" rows="4" form="swBlockForm"
                              placeholder="使用部門、使用人員、主要功能"></textarea>
                </div>
                <div class="col-md-6">
                    <label asp-for="Sheet3.DbName" class="form-label"></label>
                    <textarea asp-for="Sheet3.DbName" class="form-control" rows="4"
                              placeholder="例：Oracle DB Server：FEDB"></textarea>
                </div>

                <div class="col-12 mt-4"><h6 class="text-muted border-bottom pb-1 mb-0">II. 備份</h6></div>
                <div class="col-md-6">
                    <label asp-for="Sheet3.BackupLocation" class="form-label"></label>
                    <textarea asp-for="Sheet3.BackupLocation" class="form-control" rows="2"
                              placeholder="例：同地:信義機房 異地:板橋機房"></textarea>
                </div>
                <div class="col-md-6">
                    <label asp-for="Sheet3.BackupCycle" class="form-label"></label>
                    <input asp-for="Sheet3.BackupCycle" class="form-control" placeholder="例：每天、每週" />
                </div>

                <div class="col-12 mt-4">
                    <h6 class="text-muted border-bottom pb-1 mb-0">
                        III. 外部單位存取權限盤點 <small>（無外部存取則填 N/A）</small>
                    </h6>
                </div>
                <div class="col-md-4">
                    <label asp-for="Sheet3.ExternalUnitName" class="form-label"></label>
                    <input asp-for="Sheet3.ExternalUnitName" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="Sheet3.HasLog" class="form-label"></label>
                    <select asp-for="Sheet3.HasLog" class="form-select">
                        <option value="">請選擇</option>
                        <option>Y</option>
                        <option>N</option>
                        <option>N/A</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label asp-for="Sheet3.AccessCreate" class="form-label"></label>
                    <input asp-for="Sheet3.AccessCreate" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="Sheet3.AccessDelete" class="form-label"></label>
                    <input asp-for="Sheet3.AccessDelete" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="Sheet3.AccessCopy" class="form-label"></label>
                    <input asp-for="Sheet3.AccessCopy" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Sheet3.FileDescription" class="form-label"></label>
                    <input asp-for="Sheet3.FileDescription" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="Sheet3.SpecialData" class="form-label"></label>
                    <input asp-for="Sheet3.SpecialData" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="Sheet3.SubjectCount" class="form-label"></label>
                    <input asp-for="Sheet3.SubjectCount" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="Sheet3.RetentionPeriod" class="form-label"></label>
                    <input asp-for="Sheet3.RetentionPeriod" class="form-control" />
                </div>

                <div class="col-12 mt-4"><h6 class="text-muted border-bottom pb-1 mb-0">IV. 備註</h6></div>
                <div class="col-12">
                    <textarea asp-for="Sheet3.Remark" class="form-control" rows="2"></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-4 d-flex gap-2">
        <button type="submit" class="btn btn-info text-white">儲存 盤點表</button>
        <a class="btn btn-outline-secondary" asp-controller="@from" asp-action="Index" asp-route-clear="1">取消</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
