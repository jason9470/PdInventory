@model PdInventory.Models.InfoSystem
@{
    ViewData["Title"] = $"編輯 {Model.SystemCode} {Model.SystemName}";
    // 從哪張清單進來的；三個區塊都要把它帶進 POST，存檔後導回本頁時才不會遺失
    var from = (string)(ViewBag.From ?? PdInventory.Helpers.ListSource.Default);
}

@*
    SW / DA / 系統盤點 三個區塊的統一編輯畫面（對應 Systems/Details 的呈現方式）。
    每個區塊各自是一個 <form>，各自 POST 到原本的控制器，因此[儲存]只寫入該區塊的欄位。

    共用欄位（編號／資產編號／資產名稱）只在「系統基本資訊」區塊維護。
    SW 與 DA 區塊放同名的 hidden 欄位純粹是為了通過 [Required] 驗證；
    對應的 Apply 方法已不再寫入它們，所以不會用載入當下的舊值蓋掉別的區塊剛存的修改。
    hidden 欄位刻意不用 asp-for，避免三個 form 產生重複的 DOM id。
*@

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>編輯：@Model.SeqNo @Model.SystemCode @Model.SystemName</h2>
    <div>
        <a class="btn btn-outline-info" asp-controller="Systems" asp-action="Details"
           asp-route-id="@Model.Id" asp-route-from="@from">檢視</a>
        <a class="btn btn-outline-secondary" asp-controller="@from" asp-action="Index" asp-route-clear="1">取消</a>
    </div>
</div>

<p class="text-muted small">三個區塊各自獨立儲存，按下區塊右上角的[儲存]只會寫入該區塊的欄位。</p>

