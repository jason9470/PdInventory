<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 個資盤點管理系統</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PdInventory.styles.css" asp-append-version="true" />
    @* 在首次繪製前套用收合狀態，避免換頁時側邊欄閃一下才收起來 *@
    <script>
        try {
            var d = document.documentElement;
            if (localStorage.getItem('pdinv.sidebarCollapsed') === '1') d.classList.add('sidebar-collapsed');
            if (localStorage.getItem('pdinv.maintCollapsed') === '1') d.classList.add('maint-collapsed');
            if (localStorage.getItem('pdinv.exportCollapsed') === '1') d.classList.add('export-collapsed');
        } catch (e) { }
    </script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-3">
            <div class="container-fluid">
                <button id="sidebarToggle" type="button"
                        class="btn btn-sm btn-outline-light me-2 d-none d-lg-inline-block"
                        aria-controls="appSidebar" aria-label="收合/展開左側清單" title="收合/展開左側清單">☰</button>
                @* me-auto：navbar 的 container 是 space-between，移除選單後只剩兩個子元素會被推到兩端 *@
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">個資盤點管理系統</a>
                @if (CurrentUser.IsAuthenticated)
                {
                    @* 盤點重點：任何一頁都打得開，看完關掉就回到原本的工作 *@
                    <button id="noteToggle" type="button" class="btn btn-sm btn-light rounded-circle ms-2 me-auto"
                            aria-label="盤點重點" title="盤點重點">?</button>
                }
                else
                {
                    <span class="me-auto"></span>
                }
                @if (CurrentUser.IsAuthenticated)
                {
                    <div class="d-flex align-items-center">
                        <span class="navbar-text text-white small me-3">
                            @CurrentUser.DisplayName，您好！
                            <span class="badge text-bg-light ms-1">@RoleDisplay.Name(CurrentUser.Role ?? UserRole.AssetOwner)</span>
                        </span>
                        <form method="post" asp-controller="Account" asp-action="Logout">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-light">登出</button>
                        </form>
                    </div>
                }
            </div>
        </nav>
    </header>
    <div class="container-fluid px-4">
        <div class="row g-4">
            @* 左側清單：與上方 Nav 相同的連結；窄螢幕已有漢堡選單，故只在寬螢幕顯示 *@
            <aside id="appSidebar" class="app-sidebar col-lg-3 col-xl-2 d-none d-lg-block">
                <nav class="sidebar-nav">
                    <div class="list-group list-group-flush small">
                        <a class="list-group-item list-group-item-action @NavActive("Software")"
                           asp-controller="Software" asp-action="Index">資訊資產清單-軟體(SW)</a>
                        <a class="list-group-item list-group-item-action @NavActive("Data")"
                           asp-controller="Data" asp-action="Index">資訊資產清單-資料(DA)</a>
                        <a class="list-group-item list-group-item-action @NavActive("Systems")"
                           asp-controller="Systems" asp-action="Index">資訊系統/資料庫/伺服器盤點表</a>
                        <a class="list-group-item list-group-item-action @NavActive("Inventory")"
                           asp-controller="Inventory" asp-action="Index">個人資料檔案盤點表-人為產出</a>
                        <a class="list-group-item list-group-item-action @NavActive("Transfers")"
                           asp-controller="Transfers" asp-action="Index">系統自動拋轉(出/入)清單-系統產出</a>
                        <a class="list-group-item list-group-item-action @NavActive("Risk")"
                           asp-controller="Risk" asp-action="Index">個人資料風險自評表</a>
                    </div>

                    @* 維護資料、維護匯出與權限設定只有管理者能用，非管理者連入口都不顯示 *@
                    @if (CurrentUser.IsAdmin)
                    {
                    <button id="maintToggle" type="button"
                            class="sidebar-heading btn btn-link text-muted small fw-bold text-decoration-none
                                   d-flex align-items-center justify-content-between w-100 mt-3 mb-1 px-3"
                            aria-controls="sidebarMaint">
                        <span>維護資料</span>
                        <span class="maint-caret" aria-hidden="true">▾</span>
                    </button>
                    @* 第二層用 <details>：所在群組由伺服器端直接開著，不必等 JavaScript，
                       換頁時也不會先展開再收起來。項目清單見 Helpers/MaintenanceCatalog.cs *@
                    <div id="sidebarMaint" class="sidebar-maint">
                        @{ var activeGroup = MaintenanceCatalog.GroupKeyOf(CurrentController, CurrentField); }
                        @foreach (var group in MaintenanceCatalog.Groups)
                        {
                            <details class="sidebar-maint-group" open="@(group.Key == activeGroup)">
                                <summary class="sidebar-maint-summary">@group.Title</summary>
                                <div class="list-group list-group-flush small">
                                    @foreach (var item in group.Items)
                                    {
                                        <a class="list-group-item list-group-item-action @MaintActive(item)"
                                           asp-controller="@item.Controller" asp-action="Index"
                                           asp-route-field="@item.Field">@item.Title</a>
                                    }
                                    @if (group.Items.Count == 0)
                                    {
                                        <span class="list-group-item text-muted fst-italic">尚無維護項目</span>
                                    }
                                </div>
                            </details>
                        }
                    </div>

                    <button id="exportToggle" type="button"
                            class="sidebar-heading btn btn-link text-muted small fw-bold text-decoration-none
                                   d-flex align-items-center justify-content-between w-100 mt-3 mb-1 px-3"
                            aria-controls="sidebarExport">
                        <span>維護匯出</span>
                        <span class="export-caret" aria-hidden="true">▾</span>
                    </button>
                    <div id="sidebarExport" class="sidebar-export list-group list-group-flush small">
                        @foreach (var (key, info) in PdInventory.Helpers.ExportCatalog.Lists)
                        {
                            <a class="list-group-item list-group-item-action @ExportActive(key)"
                               asp-controller="ExportSettings" asp-action="Edit" asp-route-list="@key">@info.Title</a>
                        }
                    </div>

                    <div class="list-group list-group-flush small mt-3">
                        <a class="list-group-item list-group-item-action @NavActive("Permissions")"
                           asp-controller="Permissions" asp-action="Index">權限設定</a>
                    </div>
                    }
                </nav>
            </aside>

            <div class="app-main col-12 col-lg-9 col-xl-10">
                <main role="main" class="pb-3">
                    @if (TempData["Message"] is string message)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @message
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="關閉"></button>
                        </div>
                    }
                    @if (TempData["Error"] is string error)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @error
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="關閉"></button>
                        </div>
                    }
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - 個資盤點管理系統
        </div>
    </footer>
    @* 到最頂部／到最底部：固定顯示，行為見 site.js *@
    <div class="page-jump">
        <button id="backToTop" type="button" aria-label="到最頂部" title="到最頂部">
            <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" focusable="false">
                <path d="M8 4.5 2.5 10l1.06 1.06L8 6.62l4.44 4.44L13.5 10z" fill="currentColor" />
            </svg>
        </button>
        <button id="backToBottom" type="button" aria-label="到最底部" title="到最底部">
            <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" focusable="false">
                <path d="M8 11.5 13.5 6l-1.06-1.06L8 9.38 3.56 4.94 2.5 6z" fill="currentColor" />
            </svg>
        </button>
    </div>

    @if (CurrentUser.IsAuthenticated)
    {
        <div class="modal fade" id="noteModal" tabindex="-1" aria-labelledby="noteModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-scrollable modal-lg">
                <div class="modal-content">
                    <div class="modal-header py-2">
                        <h2 class="modal-title h6 mb-0" id="noteModalLabel">盤點重點</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
                    </div>
                    @* 三個畫面（清單／內容／編輯）都由 NotesController 以部分檢視回傳，換進這裡 *@
                    <div class="modal-body" id="noteModalBody"></div>
                </div>
            </div>
        </div>
    }

    @* 「使用中」明細。內容由 UsageController 以部分檢視回傳，換進這裡。
       只有管理者進得了維護畫面，因此這個視窗也只對管理者輸出。 *@
    @if (CurrentUser.IsAdmin)
    {
        <div class="modal fade" id="usageModal" tabindex="-1" aria-labelledby="usageModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-scrollable modal-xl">
                <div class="modal-content">
                    <div class="modal-header py-2">
                        <h2 class="modal-title h6 mb-0" id="usageModalLabel">使用中的資料</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
                    </div>
                    <div class="modal-body" id="usageModalBody"></div>
                </div>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    /// <summary>「維護匯出」目前所在清單的高亮。</summary>
    string ExportActive(string listKey) =>
        string.Equals(ViewContext.RouteData.Values["controller"] as string, "ExportSettings",
                      StringComparison.OrdinalIgnoreCase)
        && string.Equals(Context.Request.Query["list"], listKey, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";

    /// <summary>左側清單目前所在頁面的高亮。</summary>
    string NavActive(string controller) =>
        string.Equals(CurrentController, controller, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";

    /// <summary>目前的控制器名稱，供高亮與「維護資料」自動展開所在群組使用。</summary>
    string? CurrentController => ViewContext.RouteData.Values["controller"] as string;

    /// <summary>欄位選項的維護畫面共用一個控制器，靠這個參數分辨是哪一個欄位。</summary>
    string? CurrentField => Context.Request.Query["field"];

    /// <summary>「維護資料」項目的高亮。選項維護要連欄位一起比，否則六個會同時亮。</summary>
    string MaintActive(MaintenanceItem item) =>
        NavActive(item.Controller) == "active"
        && (item.Field is null || string.Equals(CurrentField, item.Field, StringComparison.Ordinal))
            ? "active"
            : "";
}
