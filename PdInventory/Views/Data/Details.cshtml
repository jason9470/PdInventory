@model PdInventory.Models.InfoSystem
@{
    // 這個畫面的主鍵是 DataAssets.Id：有 DA 不一定有 SW（各組的 PC／NB 就沒有），
    // 沒有 SW 時 Model 是一個空的 InfoSystem，SW 與盤點表兩個區塊整塊不顯示。
    var da = ViewBag.DataAsset as PdInventory.Models.DataAsset ?? new PdInventory.Models.DataAsset();
    var inv = ViewBag.Inventory as PdInventory.Models.SystemInventory ?? new PdInventory.Models.SystemInventory();
    var hasSoftware = (bool)(ViewBag.HasSoftware ?? true);
    var dataAssetId = (int)(ViewBag.DataAssetId ?? 0);
    var sections = ViewBag.Sections as List<string> ?? new List<string>();
    ViewData["Title"] = hasSoftware ? $"系統 {Model.SystemCode}" : $"資料資產 {da.DaAssetCode}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>
        @if (hasSoftware)
        {
            @:系統：@Model.SystemCode @Model.SystemName
        }
        else
        {
            @:資料資產：@da.DaAssetCode
        }
    </h2>
    <div>
        @if (await AssetAccess.CanModifyAsync(Model.SystemCode))
        {
            <a class="btn btn-primary" asp-controller="Data" asp-action="Edit"
               asp-route-id="@dataAssetId" asp-route-from="@ViewBag.From">編輯</a>
        }
        <a class="btn btn-outline-secondary" asp-route-clear="1"
           asp-controller="@ViewBag.From" asp-action="Index">回列表</a>
    </div>
</div>

@if (!hasSoftware)
{
    <div class="alert alert-secondary">
        這筆資料資產沒有關連的軟體資產，因此沒有 SW 與系統盤點兩個區塊。
        關連在建立時就決定，之後不再更動。
    </div>
}

@if (hasSoftware)
{
<div class="card mb-3">
    <div class="card-header fw-bold bg-primary text-white">資訊資產清單－軟體(SW)</div>
    <div class="card-body pd-body">
        <dl class="pd-grid">
            <dt>@Html.DisplayNameFor(m => m.SwStatus)</dt><dd>@Model.SwStatus</dd>
            <dt>@Html.DisplayNameFor(m => m.SwAssetType)</dt><dd>@Model.SwAssetType</dd>
            <dt>@Html.DisplayNameFor(m => m.SwSystemCategory)</dt><dd>@Model.SwSystemCategory</dd>
            <dt>@Html.DisplayNameFor(m => m.SwAdIntegration)</dt><dd>@Model.SwAdIntegration</dd>
            <dt class="pd-full">@Html.DisplayNameFor(m => m.SwDescription)</dt><dd class="pd-full" style="white-space: pre-wrap">@Model.SwDescription</dd>
            <dt>@Html.DisplayNameFor(m => m.SwOsVersion)</dt><dd>@Model.SwOsVersion</dd>
            <dt>@Html.DisplayNameFor(m => m.SwDbToolVersion)</dt><dd>@Model.SwDbToolVersion</dd>
            <dt>@Html.DisplayNameFor(m => m.SwThirdPartyComponents)</dt><dd>@Model.SwThirdPartyComponents</dd>
            <dt>@Html.DisplayNameFor(m => m.SwUserAccountGrant)</dt><dd>@Model.SwUserAccountGrant</dd>
            <dt>@Html.DisplayNameFor(m => m.SwProvidesAccountReport)</dt><dd>@Model.SwProvidesAccountReport</dd>
            <dt>@Html.DisplayNameFor(m => m.SwRiskOwner)</dt><dd>@Model.SwRiskOwner</dd>
            <dt>@Html.DisplayNameFor(m => m.SwLocation)</dt><dd>@Model.SwLocation</dd>
            <dt>@Html.DisplayNameFor(m => m.SwOwnerUnit)</dt><dd>@Model.SwOwnerUnit</dd>
            <dt>負責科別</dt>
            <dd>
                @if (sections.Count == 0)
                {
                    <span class="text-muted">未指定（只有管理者能修改）</span>
                }
                else
                {
                    @string.Join("、", sections)
                }
            </dd>
            <dt>@Html.DisplayNameFor(m => m.SwCustodianUnit)</dt><dd>@Model.SwCustodianUnit</dd>
            <dt>@Html.DisplayNameFor(m => m.SwUserUnit)</dt><dd>@Model.SwUserUnit</dd>
            <dt>@Html.DisplayNameFor(m => m.SwConfidentiality)</dt><dd>@Model.SwConfidentiality</dd>
            <dt>@Html.DisplayNameFor(m => m.SwIntegrity)</dt><dd>@Model.SwIntegrity</dd>
            <dt>@Html.DisplayNameFor(m => m.SwAvailability)</dt><dd>@Model.SwAvailability</dd>
            <dt>@Html.DisplayNameFor(m => m.SwAssetValue)</dt><dd>@Model.SwAssetValue</dd>
            <dt>@Html.DisplayNameFor(m => m.SwBusinessContact)</dt><dd>@Model.SwBusinessContact</dd>
            <dt>@Html.DisplayNameFor(m => m.SwAppManager)</dt><dd>@Model.SwAppManager</dd>
            <dt>@Html.DisplayNameFor(m => m.SwAppMaintainer)</dt><dd>@Model.SwAppMaintainer</dd>
            <dt>@Html.DisplayNameFor(m => m.SwAppMaintainerDeputy)</dt><dd>@Model.SwAppMaintainerDeputy</dd>
            <dt>@Html.DisplayNameFor(m => m.SwOperator)</dt><dd>@Model.SwOperator</dd>
            <dt>@Html.DisplayNameFor(m => m.SwDevMode)</dt><dd>@Model.SwDevMode</dd>
            <dt>@Html.DisplayNameFor(m => m.SwMaintMode)</dt><dd>@Model.SwMaintMode</dd>
            <dt>@Html.DisplayNameFor(m => m.SwVendor)</dt><dd>@Model.SwVendor</dd>
            <dt>@Html.DisplayNameFor(m => m.SwLanguage)</dt><dd>@Model.SwLanguage</dd>
            <dt>@Html.DisplayNameFor(m => m.SwVersionControl)</dt><dd>@Model.SwVersionControl</dd>
            <dt>@Html.DisplayNameFor(m => m.SwApRepoPath)</dt><dd>@Model.SwApRepoPath</dd>
            <dt>@Html.DisplayNameFor(m => m.SwDeployMethod)</dt><dd>@Model.SwDeployMethod</dd>
            <dt>@Html.DisplayNameFor(m => m.SwOpRepoPath)</dt><dd>@Model.SwOpRepoPath</dd>
            <dt>@Html.DisplayNameFor(m => m.SwCodeAccess)</dt><dd>@Model.SwCodeAccess</dd>
            <dt>@Html.DisplayNameFor(m => m.SwDeveloper)</dt><dd>@Model.SwDeveloper</dd>
            <dt>@Html.DisplayNameFor(m => m.SwDeployer)</dt><dd>@Model.SwDeployer</dd>
            <dt>@Html.DisplayNameFor(m => m.SwRpo)</dt><dd>@Model.SwRpo</dd>
            <dt>@Html.DisplayNameFor(m => m.SwLocalBackup)</dt><dd>@Model.SwLocalBackup</dd>
            <dt>@Html.DisplayNameFor(m => m.SwLocalBackupType)</dt><dd>@Model.SwLocalBackupType</dd>
            <dt>@Html.DisplayNameFor(m => m.SwLocalBackupFreq)</dt><dd>@Model.SwLocalBackupFreq</dd>
            <dt>@Html.DisplayNameFor(m => m.SwRemoteBackup)</dt><dd>@Model.SwRemoteBackup</dd>
            <dt>@Html.DisplayNameFor(m => m.SwRemoteBackupType)</dt><dd>@Model.SwRemoteBackupType</dd>
            <dt>@Html.DisplayNameFor(m => m.SwRemoteBackupFreq)</dt><dd>@Model.SwRemoteBackupFreq</dd>
            <dt>@Html.DisplayNameFor(m => m.SwLocalHa)</dt><dd>@Model.SwLocalHa</dd>
            <dt>@Html.DisplayNameFor(m => m.SwLocalHaArch)</dt><dd>@Model.SwLocalHaArch</dd>
            <dt>@Html.DisplayNameFor(m => m.SwRemoteHa)</dt><dd>@Model.SwRemoteHa</dd>
            <dt>@Html.DisplayNameFor(m => m.SwRemoteHaArch)</dt><dd>@Model.SwRemoteHaArch</dd>
            <dt>@Html.DisplayNameFor(m => m.SwRto)</dt><dd>@Model.SwRto</dd>
            <dt>@Html.DisplayNameFor(m => m.SwHasRecoveryPlan)</dt><dd>@Model.SwHasRecoveryPlan</dd>
            <dt>@Html.DisplayNameFor(m => m.SwHasDrDrill)</dt><dd>@Model.SwHasDrDrill</dd>
            <dt class="pd-full">@Html.DisplayNameFor(m => m.SwRelatedSystems)</dt><dd class="pd-full" style="white-space: pre-wrap">@Model.SwRelatedSystems</dd>
            <dt>@Html.DisplayNameFor(m => m.SwHandlesPersonalData)</dt><dd>@Model.SwHandlesPersonalData</dd>
            <dt>@Html.DisplayNameFor(m => m.SwHasUiAuth)</dt><dd>@Model.SwHasUiAuth</dd>
            <dt>@Html.DisplayNameFor(m => m.SwKeepsPdTrail)</dt><dd>@Model.SwKeepsPdTrail</dd>
            <dt>@Html.DisplayNameFor(m => m.SwProvidesApi)</dt><dd>@Model.SwProvidesApi</dd>
            <dt>@Html.DisplayNameFor(m => m.SwTrailLocation)</dt><dd>@Model.SwTrailLocation</dd>
            <dt>@Html.DisplayNameFor(m => m.SwTrailStorage)</dt><dd>@Model.SwTrailStorage</dd>
            <dt>@Html.DisplayNameFor(m => m.SwBusinessOwnerUnit)</dt><dd>@Model.SwBusinessOwnerUnit</dd>
            <dt>@Html.DisplayNameFor(m => m.SwReviewer)</dt><dd>@Model.SwReviewer</dd>
            <dt>@Html.DisplayNameFor(m => m.UpdatedBy)</dt><dd>@Model.UpdatedBy</dd>
            <dt>@Html.DisplayNameFor(m => m.UpdatedAt)</dt><dd>@Model.UpdatedAt?.ToString("yyyy-MM-dd HH:mm:ss")</dd>
            <dt class="pd-full">@Html.DisplayNameFor(m => m.SwRemark)</dt><dd class="pd-full" style="white-space: pre-wrap">@Model.SwRemark</dd>
        </dl>
    </div>
</div>
}

<div class="card mb-3">
    <div class="card-header fw-bold bg-success text-white">資訊資產清單－資料(DA)</div>
    <div class="card-body pd-body">
        <dl class="pd-grid">
            <dt>@Html.DisplayNameFor(_ => da.DaAssetCode)</dt><dd>@da.DaAssetCode</dd>
            <dt>@Html.DisplayNameFor(_ => da.DaAssetType)</dt><dd>@da.DaAssetType</dd>
            <dt>@Html.DisplayNameFor(_ => da.DaDescription)</dt><dd>@da.DaDescription</dd>
            <dt>@Html.DisplayNameFor(_ => da.DaBackupMethod)</dt><dd>@da.DaBackupMethod</dd>
            <dt>@Html.DisplayNameFor(_ => da.DaRetentionPeriod)</dt><dd>@da.DaRetentionPeriod</dd>
            <dt>@Html.DisplayNameFor(_ => da.DaHasSensitiveData)</dt><dd>@da.DaHasSensitiveData</dd>
            <dt>@Html.DisplayNameFor(_ => da.DaUserUnit)</dt><dd>@da.DaUserUnit</dd>
            <dt>關連SW編號</dt><dd>@Model.SystemCode</dd>
            <dt>@Html.DisplayNameFor(_ => da.DaBackupConfirm)</dt><dd>@da.DaBackupConfirm</dd>
            <dt>@Html.DisplayNameFor(_ => da.DaReviewer)</dt><dd>@da.DaReviewer</dd>
            <dt>@Html.DisplayNameFor(_ => da.UpdatedBy)</dt><dd>@da.UpdatedBy</dd>
            <dt>@Html.DisplayNameFor(_ => da.UpdatedAt)</dt><dd>@da.UpdatedAt?.ToString("yyyy-MM-dd HH:mm:ss")</dd>
            <dt>@Html.DisplayNameFor(_ => da.DaRemark)</dt><dd>@da.DaRemark</dd>
            <dt>@Html.DisplayNameFor(_ => da.DaAdminNote)</dt><dd style="white-space: pre-wrap">@da.DaAdminNote</dd>
        </dl>
    </div>
</div>

@if (hasSoftware)
{
<div class="card mb-3">
    <div class="card-header fw-bold">I. 系統基本資訊</div>
    <div class="card-body pd-body">
        <dl class="pd-spec">
            <dt>@Html.DisplayNameFor(m => m.SystemCode)</dt>
            <dd>@Model.SystemCode</dd>
            <dt>@Html.DisplayNameFor(m => m.SystemName)</dt>
            <dd>@Model.SystemName</dd>
            <dt>@Html.DisplayNameFor(_ => inv.DbName)</dt>
            <dd style="white-space: pre-wrap">@inv.DbName</dd>
        </dl>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header fw-bold">II. 備份</div>
    <div class="card-body pd-body">
        <dl class="pd-spec">
            <dt>@Html.DisplayNameFor(_ => inv.BackupLocation)</dt>
            <dd style="white-space: pre-wrap">@inv.BackupLocation</dd>
            <dt>@Html.DisplayNameFor(_ => inv.BackupCycle)</dt>
            <dd>@inv.BackupCycle</dd>
        </dl>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header fw-bold">III. 外部單位存取權限盤點</div>
    <div class="card-body pd-body">
        <dl class="pd-spec">
            <dt>@Html.DisplayNameFor(_ => inv.ExternalUnitName)</dt>
            <dd>@inv.ExternalUnitName</dd>
            <dt>@Html.DisplayNameFor(_ => inv.HasLog)</dt>
            <dd>@inv.HasLog</dd>
            <dt>@Html.DisplayNameFor(_ => inv.AccessCreate)</dt>
            <dd>@inv.AccessCreate</dd>
            <dt>@Html.DisplayNameFor(_ => inv.AccessDelete)</dt>
            <dd>@inv.AccessDelete</dd>
            <dt>@Html.DisplayNameFor(_ => inv.AccessCopy)</dt>
            <dd>@inv.AccessCopy</dd>
            <dt>@Html.DisplayNameFor(_ => inv.FileDescription)</dt>
            <dd>@inv.FileDescription</dd>
            <dt>@Html.DisplayNameFor(_ => inv.SpecialData)</dt>
            <dd>@inv.SpecialData</dd>
            <dt>@Html.DisplayNameFor(_ => inv.SubjectCount)</dt>
            <dd>@inv.SubjectCount</dd>
            <dt>@Html.DisplayNameFor(_ => inv.RetentionPeriod)</dt>
            <dd>@inv.RetentionPeriod</dd>
        </dl>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header fw-bold">IV. 備註</div>
    <div class="card-body">
        <p class="mb-0">@inv.Remark</p>
    </div>
</div>
}
