@model PdInventory.Models.InfoSystem
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "新增資料資產(DA)" : $"編輯資料資產 {Model.DaAssetCode} {Model.DaAssetName}";
}

<h2>@ViewData["Title"]</h2>

<form method="post" asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.Id)">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="card mb-3">
        <div class="card-header fw-bold">關聯系統資訊</div>
        <div class="card-body row g-3">
            <div class="col-md-2">
                <label asp-for="SeqNo" class="form-label"></label>
                <input asp-for="SeqNo" class="form-control" />
                <span asp-validation-for="SeqNo" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="SystemCode" class="form-label">系統代碼</label>
                <input asp-for="SystemCode" class="form-control" placeholder="例：SW-108" />
            </div>
            <div class="col-md-7">
                <label asp-for="SystemName" class="form-label">系統名稱</label>
                <input asp-for="SystemName" class="form-control" placeholder="例：經紀帳務系統" />
                <span asp-validation-for="SystemName" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header fw-bold bg-success text-white">資料資產(DA)明細</div>
        <div class="card-body row g-3">
            <div class="col-md-3"><label asp-for="DaAssetCode" class="form-label"></label><input asp-for="DaAssetCode" class="form-control" placeholder="例：DA-119" /></div>
            <div class="col-md-3"><label asp-for="DaAssetType" class="form-label"></label><input asp-for="DaAssetType" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="DaStatus" class="form-label"></label><input asp-for="DaStatus" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="DaAssetName" class="form-label"></label><input asp-for="DaAssetName" class="form-control" /></div>
            <div class="col-12"><label asp-for="DaDescription" class="form-label"></label><textarea asp-for="DaDescription" class="form-control" rows="2"></textarea></div>
            <div class="col-md-4"><label asp-for="DaBackupMethod" class="form-label"></label><input asp-for="DaBackupMethod" class="form-control" /></div>
            <div class="col-md-4"><label asp-for="DaRetentionPeriod" class="form-label"></label><input asp-for="DaRetentionPeriod" class="form-control" /></div>
            <div class="col-md-4"><label asp-for="DaHasSensitiveData" class="form-label"></label><input asp-for="DaHasSensitiveData" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="DaRiskOwner" class="form-label"></label><input asp-for="DaRiskOwner" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="DaLocation" class="form-label"></label><input asp-for="DaLocation" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="DaOwnerUnit" class="form-label"></label><input asp-for="DaOwnerUnit" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="DaCustodianUnit" class="form-label"></label><input asp-for="DaCustodianUnit" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="DaUserUnit" class="form-label"></label><input asp-for="DaUserUnit" class="form-control" /></div>
            <div class="col-md-2"><label asp-for="DaConfidentiality" class="form-label"></label><input asp-for="DaConfidentiality" class="form-control" /></div>
            <div class="col-md-2"><label asp-for="DaIntegrity" class="form-label"></label><input asp-for="DaIntegrity" class="form-control" /></div>
            <div class="col-md-2"><label asp-for="DaAvailability" class="form-label"></label><input asp-for="DaAvailability" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="DaAssetValue" class="form-label"></label><input asp-for="DaAssetValue" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="DaBackupConfirm" class="form-label"></label><input asp-for="DaBackupConfirm" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="DaReviewer" class="form-label"></label><input asp-for="DaReviewer" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="DaModifiedTime" class="form-label"></label><input asp-for="DaModifiedTime" class="form-control" /></div>
            <div class="col-12"><label asp-for="DaRemark" class="form-label"></label><textarea asp-for="DaRemark" class="form-control" rows="2"></textarea></div>
        </div>
    </div>

    <div class="mb-4">
        <button type="submit" class="btn btn-primary">@(isNew ? "新增" : "儲存")</button>
        <a class="btn btn-outline-secondary" asp-action="Index">取消</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
