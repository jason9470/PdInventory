@model List<PdInventory.Models.InfoSystem>
@{
    ViewData["Title"] = "資訊資產清單-資料(DA)";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>資訊資產清單-資料(DA) <small class="text-muted fs-6">(共 @Model.Count 筆)</small></h2>
    <div>
        <a class="btn btn-primary" asp-action="Create">＋ 新增資料資產</a>
    </div>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="q" value="@ViewBag.Query" class="form-control"
               placeholder="搜尋資產編號/名稱/關連SW編號/風險擁有者" style="min-width: 320px" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">搜尋</button>
        <a class="btn btn-outline-secondary" asp-action="Index">清除</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover table-sm align-middle">
        <thead class="table-dark">
            <tr>
                <th>關連SW編號</th>
                <th>資料資產編號</th>
                <th>資料資產狀態</th>
                <th>資料資產名稱</th>
                <th style="max-width: 260px">資產說明</th>
                <th>資料備份與保存方式</th>
                <th>資料保留期限</th>
                <th>有無機敏資料</th>
                <th>風險擁有者</th>
                <th style="min-width: 200px">操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.SystemCode</td>
                    <td>@s.DaAssetCode</td>
                    <td>@s.DaStatus</td>
                    <td>@s.DaAssetName</td>
                    <td class="text-break" style="max-width: 260px"><small>@s.DaDescription</small></td>
                    <td><small>@s.DaBackupMethod</small></td>
                    <td><small>@s.DaRetentionPeriod</small></td>
                    <td><small>@s.DaHasSensitiveData</small></td>
                    <td>@s.DaRiskOwner</td>
                    <td>
                        <a class="btn btn-sm btn-outline-info" asp-controller="Systems" asp-action="Details" asp-route-id="@s.Id">檢視</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@s.Id">編輯</a>
                        <form method="post" asp-action="Delete" asp-route-id="@s.Id" class="d-inline"
                              onsubmit="return confirm('確定刪除資料資產「@s.DaAssetCode @s.DaAssetName」？此動作會一併刪除同筆的 SW 與系統資料。');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">刪除</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
