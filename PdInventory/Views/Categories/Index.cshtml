@model List<PdInventory.Models.PdCategory>
@{
    ViewData["Title"] = "附表一：法務部公告個人資料類別";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>附表一：法務部公告個人資料類別 <small class="text-muted fs-6">(共 @Model.Count 項)</small></h2>
    <a class="btn btn-primary" asp-action="Create">＋ 新增類別</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="q" value="@ViewBag.Query" class="form-control"
               placeholder="搜尋代號/名稱/分類/例示" style="min-width: 300px" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">搜尋</button>
        <a class="btn btn-outline-secondary" asp-action="Index">清除</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover table-sm align-middle">
        <thead class="table-dark">
            <tr>
                <th>代號</th>
                <th>顯示代號</th>
                <th>類別名稱</th>
                <th>分類</th>
                <th style="max-width: 420px">例示</th>
                <th>使用次數</th>
                <th style="min-width: 120px">操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td><code>@c.Code</code></td>
                    <td>@c.DisplayCode</td>
                    <td>@c.Name</td>
                    <td><span class="badge bg-light text-dark border">@c.GroupName</span></td>
                    <td class="text-break" style="max-width: 420px"><small>@c.Example</small></td>
                    <td>
                        @if (c.InventoryItems.Count > 0)
                        {
                            <span class="badge bg-primary">@c.InventoryItems.Count</span>
                        }
                        else
                        {
                            <span class="text-muted">0</span>
                        }
                    </td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">編輯</a>
                        <form method="post" asp-action="Delete" asp-route-id="@c.Id" class="d-inline"
                              onsubmit="return confirm('確定刪除個資類別「@c.DisplayCode @c.Name」？');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    disabled="@(c.InventoryItems.Count > 0)"
                                    title="@(c.InventoryItems.Count > 0 ? "仍被盤點項目使用，無法刪除" : "")">刪除</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
