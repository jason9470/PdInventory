@model List<PdInventory.Models.PdCategory>
@{
    ViewData["Title"] = "附表一：法務部公告個人資料類別";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>附表一：法務部公告個人資料類別 <small class="text-muted fs-6">(共 @Model.Count 項)</small></h2>
    <a class="btn btn-primary" asp-action="Create">＋ 新增類別</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="q" value="@ViewBag.Query" class="form-control"
               placeholder="搜尋代號/名稱/分類/例示" style="min-width: 300px" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">搜尋</button>
        <a class="btn btn-outline-secondary" asp-action="Index">清除</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover table-sm align-middle pd-table">
        <thead class="table-dark">
            <tr>
                <th>代號</th>
                <th>顯示代號</th>
                <th>類別名稱</th>
                <th>分類</th>
                <th style="max-width: 420px">例示</th>
                <th style="width: 110px">使用中</th>
                <th style="min-width: 120px" data-nosort>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td><code>@c.Code</code></td>
                    <td>@c.DisplayCode</td>
                    <td>@c.Name</td>
                    <td><span class="badge bg-light text-dark border">@c.GroupName</span></td>
                    <td class="text-break" style="max-width: 420px"><small>@c.Example</small></td>
                    @{ var used = c.InventoryItems.Count; }
                    <td>
                        @if (used > 0)
                        {
                            <button type="button" class="btn btn-sm btn-link p-0 align-baseline"
                                    data-usage-kind="PdCategory" data-usage-value="@c.Code" data-usage-title="@c.DisplayCode @c.Name"
                                    title="看看是哪些資料在用">
                                <span class="badge text-bg-primary">@used 筆</span>
                            </button>
                        }
                        else
                        {
                            <span class="text-muted small">未使用</span>
                        }
                    </td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">編輯</a>
                        <form method="post" asp-action="Delete" asp-route-id="@c.Id" class="d-inline"
                              data-delete-kind="個資類別" data-delete-name="@c.DisplayCode @c.Name"
                              data-delete-mode="hard">
                            @Html.AntiForgeryToken()
                            <button type="button" class="btn btn-sm btn-outline-danger" data-confirm-delete
                                    disabled="@(used > 0)"
                                    title="@(used > 0 ? "仍被盤點項目使用，無法刪除" : "刪除")">刪除</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
