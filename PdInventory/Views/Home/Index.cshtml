@{
    ViewData["Title"] = "首頁";
}

<div class="text-center my-4">
    <h1 class="display-6">個資盤點管理系統</h1>
    <p class="text-muted">取代人工維護之「個資清冊.xlsx」，提供盤點表維護與法務部公告代碼管理</p>
</div>

<h5 class="border-bottom pb-2 mb-3">盤點與資產清單</h5>
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">資訊資產清單-軟體(SW)</h5>
                <p class="card-text text-muted">軟體資產之系統類別、作業環境、開發維護權責與備份備援設計。</p>
                <p class="fs-3 mb-2">@ViewBag.SystemCount <small class="fs-6 text-muted">套</small></p>
                <a class="btn btn-primary" asp-controller="Software" asp-action="Index">進入維護</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">資訊資產清單-資料(DA)</h5>
                <p class="card-text text-muted">資料資產之備份保存方式、保留期限與機敏資料註記。</p>
                <p class="fs-3 mb-2">@ViewBag.SystemCount <small class="fs-6 text-muted">筆</small></p>
                <a class="btn btn-primary" asp-controller="Data" asp-action="Index">進入維護</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">個人資料風險自評表</h5>
                <p class="card-text text-muted">各個資文件之風險分類、影響程度、發生可能性與控制有效性評估。</p>
                <p class="fs-3 mb-2">@ViewBag.InventoryCount <small class="fs-6 text-muted">筆</small></p>
                <a class="btn btn-primary" asp-controller="Risk" asp-action="Index">進入維護</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">個人資料檔案盤點表</h5>
                <p class="card-text text-muted">人為產出之個資檔案盤點，含個資生命循環（蒐集、處理、傳輸、保存、處置）。</p>
                <p class="fs-3 mb-2">@ViewBag.InventoryCount <small class="fs-6 text-muted">筆</small></p>
                <a class="btn btn-primary" asp-controller="Inventory" asp-action="Index">進入維護</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">系統自動拋轉清單</h5>
                <p class="card-text text-muted">系統間自動拋入/拋出之個資檔案傳輸紀錄。</p>
                <p class="fs-3 mb-2">@ViewBag.TransferCount <small class="fs-6 text-muted">筆</small></p>
                <a class="btn btn-primary" asp-controller="Transfers" asp-action="Index">進入維護</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">資訊系統盤點表</h5>
                <p class="card-text text-muted">資訊系統、資料庫與檔案伺服器之系統 layout 與備份盤點。</p>
                <p class="fs-3 mb-2">@ViewBag.SystemCount <small class="fs-6 text-muted">套</small></p>
                <a class="btn btn-primary" asp-controller="Systems" asp-action="Index">進入維護</a>
            </div>
        </div>
    </div>
</div>

<h5 class="border-bottom pb-2 mb-3">維護資料（各表下拉選項來源）</h5>
<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">附表一：法務部公告個人資料類別</h5>
                <p class="card-text text-muted">盤點表「使用資料(欄位)」之下拉選項維護資料（Ｃ○○一～Ｃ一三四）。</p>
                <p class="fs-3 mb-2">@ViewBag.CategoryCount <small class="fs-6 text-muted">項</small></p>
                <a class="btn btn-outline-primary" asp-controller="Categories" asp-action="Index">進入維護</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">附表二：法務部公告特定目的列表</h5>
                <p class="card-text text-muted">盤點表「特定目的」之下拉選項維護資料（001～182）。</p>
                <p class="fs-3 mb-2">@ViewBag.PurposeCount <small class="fs-6 text-muted">項</small></p>
                <a class="btn btn-outline-primary" asp-controller="Purposes" asp-action="Index">進入維護</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="card-title">3-1：風險分類編號</h6>
                <p class="card-text text-muted small">風險自評「風險分類編號/風險描述分類/潛在風險事件」之下拉選項。</p>
                <p class="fs-4 mb-2">@ViewBag.RiskCategoryCount <small class="fs-6 text-muted">項</small></p>
                <a class="btn btn-sm btn-outline-primary" asp-controller="RiskCategories" asp-action="Index">進入維護</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="card-title">3-2：評估影響程度</h6>
                <p class="card-text text-muted small">風險自評「影響程度評估」之下拉選項（1～5 級）。</p>
                <p class="fs-4 mb-2">@ViewBag.RiskImpactCount <small class="fs-6 text-muted">級</small></p>
                <a class="btn btn-sm btn-outline-primary" asp-controller="RiskImpacts" asp-action="Index">進入維護</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="card-title">3-3：評估發生可能性</h6>
                <p class="card-text text-muted small">風險自評「發生可能性評估」之下拉選項（1～5 級）。</p>
                <p class="fs-4 mb-2">@ViewBag.RiskLikelihoodCount <small class="fs-6 text-muted">級</small></p>
                <a class="btn btn-sm btn-outline-primary" asp-controller="RiskLikelihoods" asp-action="Index">進入維護</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="card-title">3-4：有效性評估</h6>
                <p class="card-text text-muted small">風險自評「控制有效性等級」之下拉選項（1～5 級）。</p>
                <p class="fs-4 mb-2">@ViewBag.RiskEffectivenessCount <small class="fs-6 text-muted">級</small></p>
                <a class="btn btn-sm btn-outline-primary" asp-controller="RiskEffectiveness" asp-action="Index">進入維護</a>
            </div>
        </div>
    </div>
</div>
