@model List<PdInventory.Models.InfoSystem>
@{
    ViewData["Title"] = "資訊資產清單-軟體(SW)";
    // 統一的檢視／編輯畫面以 DataAssets.Id 為主鍵，由控制器補查後放進 ViewBag
    var dataAssetIds = ViewBag.DataAssetIds as Dictionary<string, int>
                       ?? new Dictionary<string, int>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>資訊資產清單-軟體(SW) <small class="text-muted fs-6">(共 @Model.Count 套)</small></h2>
    <div>
        @if (AssetAccess.CanCreate)
        {
            <a class="btn btn-primary" asp-controller="Data" asp-action="Create"
           asp-route-from="Software">＋ 新增軟體資產</a>
        }
    </div>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="q" value="@ViewBag.Query" class="form-control"
               placeholder="搜尋資產編號/資產名稱" style="min-width: 320px" />
    </div>
    <div class="col-auto">
        @* 組別＝SW-權責單位。與搜尋欄共用同一顆[搜尋]與[清除]，條件同樣記在 Session *@
        <select name="team" class="form-select" style="min-width: 150px">
            <option value="">全部組別</option>
            @foreach (var unit in Lookup.OptionsFor(nameof(PdInventory.Models.InfoSystem.SwOwnerUnit)))
            {
                <option value="@unit" selected="@(unit == (string?)ViewBag.Team)">@unit</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">搜尋</button>
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-clear="1">清除</a>
    </div>
    @* ms-auto：匯出靠右，與左邊的搜尋條件分開 *@
    <div class="col-auto ms-auto">
        <a class="btn btn-outline-success" asp-action="Export"
           asp-route-q="@ViewBag.Query" asp-route-team="@ViewBag.Team">匯出 Excel</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover table-sm align-middle table-sortable pd-table">
        <thead class="table-dark">
            <tr>
                <th>資產狀態</th>
                <th>資產編號</th>
                <th>資產名稱</th>
                <th>系統類別</th>
                <th style="max-width: 260px">資產說明</th>
                <th>作業系統/版本</th>
                <th>資料庫工具/版本</th>
                <th>權責單位</th>
                <th>應用系統主管</th>
                <th>是否有處理個資</th>
                <th style="min-width: 200px" data-nosort>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.SwStatus</td>
                    <td class="pd-code">@s.SystemCode</td>
                    <td>@s.SystemName</td>
                    <td>@s.SwSystemCategory</td>
                    <td class="text-break" style="max-width: 260px"><small>@s.SwDescription</small></td>
                    <td><small>@s.SwOsVersion</small></td>
                    <td><small>@s.SwDbToolVersion</small></td>
                    <td>@s.SwOwnerUnit</td>
                    <td>@s.SwAppManager</td>
                    <td>@s.SwHandlesPersonalData</td>
                    @* 統一的檢視／編輯畫面以 DataAssets.Id 為主鍵；每個 SW 都配一列 DA，
                       真的查不到就不顯示那兩顆按鈕，而不是連到一個開不起來的網址 *@
                    @{ var dataId = dataAssetIds.GetValueOrDefault(s.SystemCode); }
                    <td>
                        @if (dataId > 0)
                        {
                            <a class="btn btn-sm btn-outline-info" asp-controller="Data" asp-action="Details"
                               asp-route-id="@dataId" asp-route-from="Software">檢視</a>
                        }
                        @* 編輯與刪除鈕只出現在自己科別負責的資產上（能改就能刪） *@
                        @if (await AssetAccess.CanModifyAsync(s.SystemCode))
                        {
                            @if (dataId > 0)
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-controller="Data" asp-action="Edit"
                                   asp-route-id="@dataId" asp-route-from="Software">編輯</a>
                            }
                            @if (await AssetAccess.CanDeleteAsync(s.SystemCode))
                            {
                                <form method="post" asp-action="Delete" asp-route-id="@s.Id" class="d-inline"
                                      data-delete-kind="軟體資產" data-delete-name="@s.SystemCode @s.SystemName"
                                      data-delete-mode="soft" data-delete-detail="同一筆資產的 DA 與盤點表資料會一併刪除。">
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-confirm-delete>刪除</button>
                                </form>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
