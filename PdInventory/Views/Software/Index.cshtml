@model List<PdInventory.Models.InfoSystem>
@{
    ViewData["Title"] = "資訊資產清單-軟體(SW)";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>資訊資產清單-軟體(SW) <small class="text-muted fs-6">(共 @Model.Count 套)</small></h2>
    <div>
        <a class="btn btn-primary" asp-action="Create">＋ 新增軟體資產</a>
    </div>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="q" value="@ViewBag.Query" class="form-control"
               placeholder="搜尋資產編號/名稱/系統類別/風險擁有者" style="min-width: 320px" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">搜尋</button>
        <a class="btn btn-outline-secondary" asp-action="Index">清除</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover table-sm align-middle">
        <thead class="table-dark">
            <tr>
                <th>資產編號</th>
                <th>資產狀態</th>
                <th>軟體資產名稱</th>
                <th>系統類別</th>
                <th>是否為核心系統</th>
                <th style="max-width: 260px">資產說明</th>
                <th>作業系統/版本</th>
                <th>資料庫工具/版本</th>
                <th>風險擁有者</th>
                <th>是否有處理個資</th>
                <th style="min-width: 200px">操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.SystemCode</td>
                    <td>@s.SwStatus</td>
                    <td>@s.SystemName</td>
                    <td>@s.SwSystemCategory</td>
                    <td>@s.SwIsCoreSystem</td>
                    <td class="text-break" style="max-width: 260px"><small>@s.Description</small></td>
                    <td><small>@s.SwOsVersion</small></td>
                    <td><small>@s.SwDbToolVersion</small></td>
                    <td>@s.SwRiskOwner</td>
                    <td>@s.SwHandlesPersonalData</td>
                    <td>
                        <a class="btn btn-sm btn-outline-info" asp-controller="Systems" asp-action="Details" asp-route-id="@s.Id">檢視</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@s.Id">編輯</a>
                        <form method="post" asp-action="Delete" asp-route-id="@s.Id" class="d-inline"
                              onsubmit="return confirm('確定刪除軟體資產「@s.SystemCode @s.SystemName」？此動作會一併刪除同筆的 DA 與系統資料。');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">刪除</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
