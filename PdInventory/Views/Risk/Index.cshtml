@model List<PdInventory.Models.InventoryItem>
@{
    ViewData["Title"] = "個人資料風險自評表";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>個人資料風險自評表 <small class="text-muted fs-6">(共 @Model.Count 筆)</small></h2>
    <div>
        @if (AssetAccess.CanCreate)
        {
            <a class="btn btn-primary" asp-action="Create">＋ 新增風險自評</a>
        }
    </div>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="q" value="@ViewBag.Query" class="form-control"
               placeholder="搜尋文件名稱/資產編號/資產名稱" style="min-width: 360px" />
    </div>
    <div class="col-auto">
        @* 組別＝SW-權責單位。與搜尋欄共用同一顆[搜尋]與[清除]，條件同樣記在 Session *@
        <select name="team" class="form-select" style="min-width: 150px">
            <option value="">全部組別</option>
            @foreach (var unit in Lookup.OptionsFor(nameof(PdInventory.Models.InfoSystem.SwOwnerUnit)))
            {
                <option value="@unit" selected="@(unit == (string?)ViewBag.Team)">@unit</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">搜尋</button>
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-clear="1">清除</a>
    </div>
    @* ms-auto：匯出靠右，與左邊的搜尋條件分開 *@
    <div class="col-auto ms-auto">
        <a class="btn btn-outline-success" asp-action="Export"
           asp-route-q="@ViewBag.Query" asp-route-team="@ViewBag.Team">匯出 Excel</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover table-sm align-middle table-sortable pd-table">
        <thead class="table-dark">
            <tr>
                <th style="max-width: 240px">個資文件/檔案名稱</th>
                <th>資產編號</th>
                <th>資產名稱</th>
                <th>資料序號</th>
                <th>風險分類編號</th>
                <th>影響程度</th>
                <th>發生可能性</th>
                <th>有效性等級</th>
                <th>風險值</th>
                <th style="min-width: 170px" data-nosort>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-break" style="max-width: 240px">@item.DocumentName</td>
                    <td class="pd-code">@item.SystemCode</td>
                    <td>@item.SystemName</td>
                    <td>@item.RiskDataSeqNo</td>
                    <td>@item.RiskCategoryCode</td>
                    <td><small>@item.RiskImpactLevel</small></td>
                    <td><small>@item.RiskLikelihoodLevel</small></td>
                    <td><small>@item.RiskEffectivenessLevel</small></td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(item.RiskValue))
                        {
                            <span class="badge bg-warning text-dark fs-6">@item.RiskValue</span>
                        }
                    </td>
                    <td>
                        <a class="btn btn-sm btn-outline-info" asp-action="Details" asp-route-id="@item.Id">檢視</a>
                        @* 編輯與刪除鈕只出現在自己科別負責的資產上（能改就能刪） *@
                        @if (await AssetAccess.CanModifyAsync(item.SystemCode))
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">編輯</a>
                            @if (await AssetAccess.CanDeleteAsync(item.SystemCode))
                            {
                                <form method="post" asp-action="Delete" asp-route-id="@item.Id" class="d-inline"
                                      data-delete-kind="風險自評資料" data-delete-name="@item.SystemCode @item.DocumentName"
                                      data-delete-mode="clear" data-delete-detail="會清空這一筆的風險自評欄位，個資盤點項目本身不受影響。">
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-confirm-delete>刪除</button>
                                </form>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
