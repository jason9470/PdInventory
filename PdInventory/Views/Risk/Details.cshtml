@model PdInventory.Models.InventoryItem
@{
    ViewData["Title"] = $"風險自評 {Model.SystemCode} {Model.DocumentName}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>風險自評：@Model.SystemCode @Model.DocumentName</h2>
    <div>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">編輯</a>
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-clear="1">回列表</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header fw-bold">盤點基本資訊（來自個人資料檔案盤點表）</div>
    <div class="card-body pd-body">
        <dl class="pd-spec">
            <dt>編號</dt>
            <dd>@Model.SeqNo</dd>
            <dt>資產編號</dt>
            <dd>@Model.SystemCode</dd>
            <dt>資產名稱</dt>
            <dd>@Model.SystemName</dd>
            <dt>個資文件/檔案名稱</dt>
            <dd>@Model.DocumentName</dd>
        </dl>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header fw-bold bg-primary text-white">潛在風險事件項目</div>
    <div class="card-body pd-body">
        <dl class="pd-spec">
            <dt>資料序號</dt>
            <dd>@Model.RiskDataSeqNo</dd>
            <dt>風險分類編號</dt>
            <dd>@Model.RiskCategoryCode</dd>
            <dt>風險描述分類</dt>
            <dd>@Model.RiskCategoryName</dd>
            <dt>潛在風險事件</dt>
            <dd style="white-space: pre-line">@Model.RiskEvent</dd>
        </dl>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header fw-bold bg-primary text-white">風險評估</div>
    <div class="card-body pd-body">
        <dl class="pd-spec">
            <dt>影響程度評估</dt>
            <dd>@Model.RiskImpactLevel</dd>
            <dt>發生可能性評估</dt>
            <dd>@Model.RiskLikelihoodLevel</dd>
            <dt>控制有效性等級</dt>
            <dd>@Model.RiskEffectivenessLevel</dd>
            <dt>相關規範(程序規章)</dt>
            <dd>@Model.RiskRelatedRegulation</dd>
            <dt>現有控制點說明</dt>
            <dd style="white-space: pre-line">@Model.RiskControlDescription</dd>
            <dt>風險值</dt>
            <dd>
                @if (!string.IsNullOrWhiteSpace(Model.RiskValue))
                {
                    <span class="badge bg-warning text-dark fs-6">@Model.RiskValue</span>
                }
            </dd>
        </dl>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header fw-bold">改善與確認</div>
    <div class="card-body pd-body">
        <dl class="pd-spec">
            <dt>改善措施或方案</dt>
            <dd style="white-space: pre-line">@Model.RiskImprovementPlan</dd>
            <dt>風險管理單位確認說明</dt>
            <dd style="white-space: pre-line">@Model.RiskUnitConfirm</dd>
            <dt>備註</dt>
            <dd style="white-space: pre-line">@Model.RiskRemark</dd>
        </dl>
    </div>
</div>

<div class="mb-4">
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">編輯</a>
    <a class="btn btn-outline-secondary" asp-action="Index" asp-route-clear="1">回列表</a>
</div>
