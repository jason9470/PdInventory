@model List<PdInventory.Models.Employee>
@{
    var usage = (Dictionary<string, int>)ViewBag.UsageCounts;
    var scope = (SectionScope)ViewBag.Scope;
    var sections = (List<Section>)ViewBag.Sections;
    var accounts = (Dictionary<string, AppUser>)ViewBag.Accounts;
    var sectionFilter = (int?)ViewBag.SectionFilter;
    var roleFilter = (UserRole?)ViewBag.RoleFilter;
    ViewData["Title"] = "人員";
    var pending = Model.Count(e => string.IsNullOrWhiteSpace(e.TeamName));
    var managers = Model.Count(e => e.IsManager);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>
        人員 <small class="text-muted fs-6">(共 @Model.Count 人，其中主管 @managers 人)</small>
    </h2>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="OrgChart">組織圖</a>
        <a class="btn btn-primary" asp-action="Create">＋ 新增人員</a>
    </div>
</div>

<p class="text-muted small">
    一個人的權限在這裡一次設定：<strong>科別決定能修改哪些系統</strong>（各科負責哪些系統在<a asp-controller="Sections" asp-action="Index">科別</a>設定），
    <strong>角色決定能做哪些動作</strong>，管理者不受科別限制。組別跟著科別自動帶出。
    新增人員時會一併建立登入帳號（沒有員編的除外），刪除時帳號一起停用。
</p>
<p class="text-muted small">
    對照欄位：SW-應用系統維護人員（多選）、SW-程式設計人員（多選）、
    SW-115上檢視人員（單選）、DA-115檢視人員（單選）——這四個列出全部的人；
    <strong>SW-應用系統主管（單選）只列備註為「組長」或「科長」的人</strong>。
</p>

@if (pending > 0)
{
    <div class="alert alert-warning">
        有 <strong>@pending</strong> 筆沒有組別——這些是既有資料裡出現過、
        但不在名冊中的值（含幾家委外廠商），先建進來把值留住，資料待補。它們排在清單最後。
    </div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="q" value="@ViewBag.Query" class="form-control"
               placeholder="搜尋員編/姓名/部門/組別/科別" style="min-width: 320px" />
    </div>
    <div class="col-auto">
        <select name="section" class="form-select" style="min-width: 200px">
            <option value="">全部科別</option>
            @foreach (var team in sections.GroupBy(s => s.TeamName))
            {
                <optgroup label="@team.Key">
                    @foreach (var s in team)
                    {
                        <option value="@s.Id" selected="@(s.Id == sectionFilter)">@s.OptionLabel</option>
                    }
                </optgroup>
            }
        </select>
    </div>
    <div class="col-auto">
        <select name="role" class="form-select" style="min-width: 140px">
            <option value="">全部角色</option>
            @foreach (var r in RoleDisplay.All)
            {
                <option value="@r" selected="@(r == roleFilter)">@RoleDisplay.Name(r)</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">搜尋</button>
        <a class="btn btn-outline-secondary" asp-action="Index">清除</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover table-sm align-middle table-sortable pd-table">
        <thead class="table-dark">
            <tr>
                <th style="min-width: 100px">員編</th>
                <th style="min-width: 110px">姓名</th>
                <th style="min-width: 170px">部門</th>
                <th style="min-width: 110px">組別</th>
                <th style="min-width: 130px">科別</th>
                <th style="width: 110px">角色</th>
                <th style="width: 110px">可修改系統</th>
                <th style="min-width: 200px">備註</th>
                <th style="width: 110px">使用中</th>
                <th style="min-width: 120px" data-nosort>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>
                        @if (string.IsNullOrWhiteSpace(e.EmpNo))
                        {
                            <span class="badge text-bg-warning">待補</span>
                        }
                        else
                        {
                            <code>@e.EmpNo</code>
                        }
                    </td>
                    <td>@e.Name</td>
                    <td class="text-break"><small>@e.DepartmentName</small></td>
                    <td>@e.TeamName</td>
                    <td>
                        @if (e.Section is null)
                        {
                            <span class="badge text-bg-warning">未指定</span>
                        }
                        else
                        {
                            @e.Section.OptionLabel
                        }
                    </td>
                    @{
                        var editable = scope.SystemsOf(e.SectionId);
                        var account = string.IsNullOrWhiteSpace(e.EmpNo) ? null : accounts.GetValueOrDefault(e.EmpNo);
                        var isAdmin = account?.Role == UserRole.Admin;
                    }
                    <td>
                        @if (account is null)
                        {
                            <span class="text-muted small" title="沒有員編就沒有登入帳號">無帳號</span>
                        }
                        else
                        {
                            <span class="badge @(account.Role == UserRole.Admin ? "text-bg-danger"
                                               : account.Role == UserRole.Manager ? "text-bg-primary"
                                               : "text-bg-secondary")"
                                  title="最後登入：@(account.LastLoginAt?.ToString("yyyy-MM-dd HH:mm") ?? "尚未登入")">@RoleDisplay.Name(account.Role)</span>
                        }
                    </td>
                    <td>
                        @* 依科分段的完整清單在編輯畫面 *@
                        @if (isAdmin)
                        {
                            <span class="badge text-bg-danger" title="管理者不受科別限制">全部</span>
                        }
                        else if (editable.Count > 0 && account is not null)
                        {
                            <span class="badge text-bg-primary"
                                  title="@string.Join("、", editable.Select(x => x.SystemCode))">@editable.Count 套</span>
                        }
                        else if (editable.Count > 0)
                        {
                            <span class="badge text-bg-secondary" title="沒有員編，無法登入">@editable.Count 套</span>
                        }
                        else
                        {
                            <span class="text-muted small">無</span>
                        }
                    </td>
                    <td class="text-break">
                        @if (e.IsManager)
                        {
                            <span class="badge text-bg-primary">@e.Remark</span>
                        }
                        else
                        {
                            <small>@e.Remark</small>
                        }
                    </td>
                    @{ var used = usage.GetValueOrDefault(e.Name); }
                    <td>
                        @if (used > 0)
                        {
                            <button type="button" class="btn btn-sm btn-link p-0 align-baseline"
                                    data-usage-kind="Employee" data-usage-value="@e.Name" data-usage-title="@e.Name"
                                    title="看看是哪些資料在用">
                                <span class="badge text-bg-primary">@used 筆</span>
                            </button>
                        }
                        else
                        {
                            <span class="text-muted small">未使用</span>
                        }
                    </td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@e.Id">編輯</a>
                        <form method="post" asp-action="Delete" asp-route-id="@e.Id" class="d-inline"
                              data-delete-kind="人員" data-delete-name="@e.Name"
                              data-delete-mode="soft" data-delete-detail="登入帳號與權限會一併停用。">
                            @Html.AntiForgeryToken()
                            <button type="button" class="btn btn-sm btn-outline-danger" data-confirm-delete
                                    disabled="@(used > 0)"
                                    title="@(used > 0 ? "還被資料使用中，不能刪除" : "刪除")">刪除</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
