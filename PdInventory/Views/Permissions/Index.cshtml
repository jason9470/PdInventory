@model PdInventory.Models.ViewModels.PermissionsViewModel
@using PdInventory.Helpers
@using PdInventory.Models
@{
    ViewData["Title"] = "權限設定";
    var selected = Model.Selected;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>權限設定 <small class="text-muted fs-6">(共 @Model.Users.Count 位使用者)</small></h2>
</div>

<div class="row g-4">
    <div class="col-lg-5 col-xl-4">
        <div class="card">
            <div class="card-header py-2 fw-bold small d-flex justify-content-between align-items-center">
                <span>使用者</span>
                <span class="fw-normal text-muted" id="userFilterCount"></span>
            </div>
            <div class="card-body py-2">
                <div class="input-group input-group-sm">
                    <input type="search" id="userFilter" class="form-control"
                           placeholder="輸入姓名或員編快速篩選" autocomplete="off" />
                    <button type="button" class="btn btn-outline-secondary" id="userFilterClear">清除</button>
                </div>
            </div>
            <div class="list-group list-group-flush small pd-user-list">
                @foreach (var user in Model.Users)
                {
                    @* data-search：篩選比對的來源。姓名與員編都放進來，
                       使用者打哪一個都找得到 *@
                    var person = Model.EmployeeOf(user);
                    var editable = Model.EditableCount(user);
                    <a class="list-group-item list-group-item-action @(selected?.Id == user.Id ? "active" : "")"
                       data-search="@(user.EmpNo + " " + user.EmpName + " " + person?.Section?.Name + " " + person?.TeamName)"
                       asp-action="Index" asp-route-userId="@user.Id">
                        <div class="d-flex justify-content-between align-items-center">
                            <span>
                                <span class="pd-code">@user.EmpNo</span>
                                <span class="ms-2">@user.EmpName</span>
                            </span>
                            <span class="badge @(user.Role == UserRole.Admin ? "text-bg-danger"
                                               : user.Role == UserRole.Manager ? "text-bg-primary"
                                               : "text-bg-secondary")">@RoleDisplay.Name(user.Role)</span>
                        </div>
                        <div class="text-muted mt-1" style="font-size: .75rem">
                            @if (person?.Section is not null)
                            {
                                <span>@person.Section.OptionLabel ・ </span>
                            }
                            else
                            {
                                <span>未指定科別 ・ </span>
                            }
                            @(editable is null ? "全部系統" : $"可修改 {editable} 套")
                            ・ 最後登入：@(user.LastLoginAt?.ToString("yyyy-MM-dd HH:mm") ?? "尚未登入")
                        </div>
                    </a>
                }
            </div>
        </div>
        <p class="text-muted small mt-2 mb-0">
            使用者不在這裡新增或刪除，兩者都跟著<a asp-controller="Employees" asp-action="Index">人員表</a>走：
            管理者在人員表建檔時會一併建立帳號，那個人第一次登入時也會自動建檔，
            預設是一般使用者；從人員表刪除時，這裡的帳號會一起停用並且不能再登入。
            <br />
            <strong>能修改哪些系統不在這裡設定</strong>：由人員表的科別決定，
            各科負責哪些系統在<a asp-controller="Sections" asp-action="Index">科別</a>設定。
        </p>
    </div>

    <div class="col-lg-7 col-xl-8">
        @if (selected is null)
        {
            <div class="alert alert-secondary mb-0">請從左邊點選一位使用者，以調整他的角色、查看他能修改哪些系統。</div>
        }
        else
        {
            <form method="post" asp-action="Save">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@selected.Id" />
                <input type="hidden" name="rowVersion" value="@selected.RowVersion" />

                <div class="card mb-3">
                    <div class="card-header py-2 fw-bold small">
                        @selected.Label
                    </div>
                    <div class="card-body pd-form">
                        <div class="row g-3 align-items-start">
                            <div class="col-md-4">
                                <label class="form-label" for="role">角色</label>
                                <select id="role" name="role" class="form-select">
                                    @foreach (var role in RoleDisplay.All)
                                    {
                                        <option value="@role" selected="@(role == selected.Role)">
                                            @RoleDisplay.Name(role)
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">這個角色可以做什麼</label>
                                <ul class="small text-muted mb-0 ps-3">
                                    @foreach (var role in RoleDisplay.All)
                                    {
                                        <li class="@(role == selected.Role ? "fw-bold text-body" : "")">
                                            @RoleDisplay.Name(role)：@RoleDisplay.Description(role)
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                @{
                    var selectedPerson = Model.EmployeeOf(selected);
                    var breakdown = Model.Scope.BreakdownOf(selectedPerson?.SectionId);
                    var total = breakdown.SelectMany(b => b.Systems).DistinctBy(s => s.Id).Count();
                }
                <div class="card mb-3">
                    <div class="card-header py-2 d-flex justify-content-between align-items-center">
                        <span class="fw-bold small">可修改的系統
                            <span class="text-muted fw-normal">（唯讀，由科別決定）</span>
                        </span>
                        @if (selectedPerson is not null)
                        {
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Employees" asp-action="Edit"
                               asp-route-id="@selectedPerson.Id">到人員表修改科別 →</a>
                        }
                    </div>
                    <div class="card-body">
                        <dl class="row small mb-3">
                            <dt class="col-sm-2">科別</dt>
                            <dd class="col-sm-10 mb-0">
                                @(selectedPerson?.Section?.OptionLabel ?? "未指定")
                                @if (selectedPerson?.Section is not null)
                                {
                                    <span class="text-muted">（@selectedPerson.Section.TeamName）</span>
                                }
                            </dd>
                        </dl>

                        @if (selected.Role == UserRole.Admin)
                        {
                            <div class="alert alert-info small py-2 mb-0">
                                管理者不受科別限制，<strong>全部 @Model.TotalSystems 套系統</strong>都能新增、修改、刪除。
                            </div>
                        }
                        else if (selectedPerson is null)
                        {
                            <div class="alert alert-warning small py-2 mb-0">
                                人員表查不到這個帳號（員工編號 @selected.EmpNo），因此不能修改任何系統。
                            </div>
                        }
                        else if (selectedPerson.Section is null)
                        {
                            <div class="alert alert-warning small py-2 mb-0">
                                這個人還沒有指定科別，因此不能修改任何系統。
                            </div>
                        }
                        else if (selectedPerson.Section.Kind == SectionKind.Office)
                        {
                            <div class="alert alert-warning small py-2 mb-0">
                                「@selectedPerson.Section.Name」不負責任何系統，部室的權限要靠管理者角色；
                                目前的角色是@(RoleDisplay.Name(selected.Role))，因此不能修改任何系統。
                            </div>
                        }
                        else if (total == 0)
                        {
                            <div class="alert alert-warning small py-2 mb-0">
                                「@selectedPerson.Section.Name」目前沒有負責任何系統，因此不能修改任何系統。
                            </div>
                        }
                        else
                        {
                            <p class="small text-muted mb-2">
                                共 <strong class="text-body">@total</strong> 套@(selectedPerson.Section.Kind == SectionKind.Team ? "（全組各科合計）" : "")，
                                修改時連同這些系統底下的 DA、盤點表、個資盤點、拋轉清單與風險自評。
                            </p>
                            @* 變數不能叫 section：Razor 會把 @section 當成版面的 section 指令 *@
                            @foreach (var (part, systems) in breakdown)
                            {
                                @if (breakdown.Count > 1)
                                {
                                    <div class="small fw-bold mt-2 mb-1">@part.Name <span class="text-muted fw-normal">（@systems.Count 套）</span></div>
                                }
                                <div class="pd-asset-picker">
                                    @foreach (var sys in systems)
                                    {
                                        <div class="pd-asset-item" style="cursor: default">
                                            <span class="pd-code">@sys.SystemCode</span>
                                            <span class="pd-asset-name">@sys.SystemName</span>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">儲存角色</button>
                    <a class="btn btn-outline-secondary" asp-action="Index">取消</a>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
<script>
    // 使用者清單的即時篩選。
    //
    // 為什麼在前端做而不是比照六張清單的 ?q=：這個畫面點一位使用者就會整頁重載
    // （網址帶 userId），伺服器端篩選要把 q 一路帶進每個連結與存檔後的導回，
    // 而 135 位使用者本來就全部已經印在畫面上了，直接藏起來最單純。
    //
    // 條件記在 sessionStorage：挑了一位使用者之後畫面會重載，不記的話
    // 剛打的字就沒了，等於每次都要重打。
    (function () {
        var input = document.getElementById('userFilter');
        var clear = document.getElementById('userFilterClear');
        var count = document.getElementById('userFilterCount');
        var list = document.querySelector('.pd-user-list');
        if (!input || !list) return;

        var KEY = 'pd:permissions:filter';
        var items = Array.prototype.slice.call(list.querySelectorAll('[data-search]'));

        function refresh() {
            var keyword = input.value.trim().toLowerCase();
            var shown = 0;

            items.forEach(function (item) {
                var hit = !keyword || item.dataset.search.toLowerCase().indexOf(keyword) >= 0;
                item.hidden = !hit;
                if (hit) shown++;
            });

            count.textContent = keyword ? shown + ' / ' + items.length : '';

            try {
                if (keyword) sessionStorage.setItem(KEY, input.value);
                else sessionStorage.removeItem(KEY);
            } catch (e) { /* 隱私模式下不能寫，篩選本身照樣可用 */ }
        }

        try { input.value = sessionStorage.getItem(KEY) || ''; } catch (e) { /* 同上 */ }

        input.addEventListener('input', refresh);
        clear.addEventListener('click', function () { input.value = ''; refresh(); input.focus(); });
        refresh();
    })();

</script>
}
