@model List<PdInventory.Models.TransferRecord>
@{
    ViewData["Title"] = "系統自動拋轉(出/入)清單-系統產出";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>系統自動拋轉(出/入)清單-系統產出 <small class="text-muted fs-6">(共 @Model.Count 筆)</small></h2>
    <a class="btn btn-primary" asp-action="Create">＋ 新增拋轉紀錄</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="q" value="@ViewBag.Query" class="form-control"
               placeholder="搜尋資產編號/資產名稱" style="min-width: 300px" />
    </div>
    <div class="col-auto">
        <select name="type" class="form-select">
            <option value="">全部類別</option>
            <option value="拋入" selected="@("拋入" == (string?)ViewBag.Type)">拋入</option>
            <option value="拋出" selected="@("拋出" == (string?)ViewBag.Type)">拋出</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">搜尋</button>
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-clear="1">清除</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover table-sm align-middle">
        <thead class="table-dark">
            <tr>
                <th>編號</th>
                <th>類別</th>
                <th>資產編號</th>
                <th>資產名稱</th>
                <th>資料庫/資料夾名稱</th>
                <th>來源/目的地單位</th>
                <th>負責內部單位</th>
                <th>傳遞內容</th>
                <th>當事人數量</th>
                <th>委外合約/法源依據</th>
                <th>備註</th>
                <th style="min-width: 120px">操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.SeqNo</td>
                    <td>
                        @if (t.TransferType.Contains("拋入") && t.TransferType.Contains("拋出"))
                        {
                            <span class="badge bg-warning text-dark">拋入/拋出</span>
                        }
                        else if (t.TransferType.Contains("拋入"))
                        {
                            <span class="badge bg-primary">拋入</span>
                        }
                        else
                        {
                            <span class="badge bg-success">拋出</span>
                        }
                    </td>
                    <td>@t.SystemCode</td>
                    <td>@t.SystemName</td>
                    <td class="text-break" style="max-width: 220px">@t.PathName</td>
                    <td>@t.ExternalUnit</td>
                    <td>@t.InternalUnit</td>
                    <td>@t.ContentDescription</td>
                    <td>@t.SubjectCount</td>
                    <td>@t.Contract</td>
                    <td class="text-break" style="max-width: 260px"><small>@t.Remark</small></td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@t.Id">編輯</a>
                        <form method="post" asp-action="Delete" asp-route-id="@t.Id" class="d-inline"
                              onsubmit="return confirm('確定刪除拋轉紀錄「@t.SeqNo @t.SystemName」？');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">刪除</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
