@model List<PdInventory.Models.TransferRecord>
@{
    ViewData["Title"] = "系統自動拋轉(出/入)清單-系統產出";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>系統自動拋轉(出/入)清單-系統產出 <small class="text-muted fs-6">(共 @Model.Count 筆)</small></h2>
    @if (AssetAccess.CanCreate)
    {
        <a class="btn btn-primary" asp-action="Create">＋ 新增拋轉紀錄</a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="q" value="@ViewBag.Query" class="form-control"
               placeholder="搜尋資產編號/資產名稱" style="min-width: 300px" />
    </div>
    <div class="col-auto">
        <select name="type" class="form-select">
            <option value="">全部類別</option>
            <option value="拋入" selected="@("拋入" == (string?)ViewBag.Type)">拋入</option>
            <option value="拋出" selected="@("拋出" == (string?)ViewBag.Type)">拋出</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">搜尋</button>
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-clear="1">清除</a>
        <a class="btn btn-outline-success" asp-action="Export"
           asp-route-q="@ViewBag.Query" asp-route-type="@ViewBag.Type">匯出 Excel</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover table-sm align-middle table-sortable pd-table">
        <thead class="table-dark">
            <tr>
                <th>編號</th>
                <th>類別</th>
                <th>資產編號</th>
                <th>資產名稱</th>
                <th>資料庫/資料夾名稱</th>
                <th>來源/目的地單位</th>
                <th>負責內部單位</th>
                <th>傳遞內容</th>
                <th>當事人數量</th>
                <th>委外合約/法源依據</th>
                <th style="min-width: 180px" data-nosort>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.SeqNo</td>
                    <td>
                        @if (t.TransferType == "拋入")
                        {
                            <span class="badge bg-primary">拋入</span>
                        }
                        else if (t.TransferType == "拋出")
                        {
                            <span class="badge bg-success">拋出</span>
                        }
                        else
                        {
                            @* 一筆只會是拋入或拋出；出現別的值代表資料有問題，原樣顯示不猜 *@
                            <span class="badge bg-secondary">@t.TransferType</span>
                        }
                    </td>
                    <td class="pd-code">@t.SystemCode</td>
                    <td>@t.SystemName</td>
                    <td class="text-break" style="max-width: 220px">@t.PathName</td>
                    <td>@t.ExternalUnit</td>
                    <td>@t.InternalUnit</td>
                    <td>@t.ContentDescription</td>
                    <td>@t.SubjectCount</td>
                    <td>@t.Contract</td>
                    <td>
                        <a class="btn btn-sm btn-outline-info" asp-action="Details" asp-route-id="@t.Id">檢視</a>
                        @* 編輯與刪除鈕只出現在自己科別負責的資產上（能改就能刪） *@
                        @if (await AssetAccess.CanModifyAsync(t.SystemCode))
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@t.Id">編輯</a>
                            @if (await AssetAccess.CanDeleteAsync(t.SystemCode))
                            {
                                <form method="post" asp-action="Delete" asp-route-id="@t.Id" class="d-inline"
                                      data-delete-kind="拋轉紀錄" data-delete-name="@t.SeqNo @t.SystemName"
                                      data-delete-mode="soft">
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-confirm-delete>刪除</button>
                                </form>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
