@model List<PdInventory.Models.RiskImpactLevel>
@{
    ViewData["Title"] = "3-2：評估影響程度";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>3-2：評估影響程度 <small class="text-muted fs-6">(共 @Model.Count 級)</small></h2>
    <a class="btn btn-primary" asp-action="Create">＋ 新增等級</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover table-sm align-middle pd-table">
        <thead class="table-dark">
            <tr>
                <th style="width: 70px">等級</th>
                <th style="width: 120px">說明</th>
                <th style="min-width: 260px">財務衝擊</th>
                <th style="min-width: 260px">信譽損害</th>
                <th style="min-width: 220px">個資當事人隱私衝擊</th>
                <th style="min-width: 120px" data-nosort>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td><span class="badge bg-warning text-dark fs-6">@r.Level</span></td>
                    <td class="fw-bold">@r.Name</td>
                    <td class="text-break"><small>@r.FinancialImpact</small></td>
                    <td class="text-break"><small style="white-space: pre-line">@r.ReputationImpact</small></td>
                    <td class="text-break"><small style="white-space: pre-line">@r.PrivacyImpact</small></td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@r.Id">編輯</a>
                        <form method="post" asp-action="Delete" asp-route-id="@r.Id" class="d-inline"
                              onsubmit="return confirm('確定刪除影響程度「@r.Label」？');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">刪除</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
