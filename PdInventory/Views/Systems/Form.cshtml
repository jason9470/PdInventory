@model PdInventory.Models.InfoSystem
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "新增系統" : $"編輯系統 {Model.SeqNo}";
}

<h2>@ViewData["Title"]</h2>

<form method="post" asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.Id)">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="card mb-3">
        <div class="card-header fw-bold">I. 系統基本資訊</div>
        <div class="card-body row g-3">
            <div class="col-md-2">
                <label asp-for="SeqNo" class="form-label"></label>
                <input asp-for="SeqNo" class="form-control" />
                <span asp-validation-for="SeqNo" class="text-danger"></span>
            </div>
            <div class="col-md-10">
                <label asp-for="SystemName" class="form-label"></label>
                <input asp-for="SystemName" class="form-control" placeholder="例：SW-108 經紀帳務系統" />
                <span asp-validation-for="SystemName" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"
                          placeholder="使用部門、使用人員、主要功能"></textarea>
            </div>
            <div class="col-md-6">
                <label asp-for="DbName" class="form-label"></label>
                <textarea asp-for="DbName" class="form-control" rows="4"
                          placeholder="例：Oracle DB Server：FEDB"></textarea>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header fw-bold">II. 備份</div>
        <div class="card-body row g-3">
            <div class="col-md-6">
                <label asp-for="BackupLocation" class="form-label"></label>
                <textarea asp-for="BackupLocation" class="form-control" rows="2"
                          placeholder="例：同地:信義機房 異地:板橋機房"></textarea>
            </div>
            <div class="col-md-6">
                <label asp-for="BackupCycle" class="form-label"></label>
                <input asp-for="BackupCycle" class="form-control" placeholder="例：每天、每週" />
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header fw-bold">III. 外部單位存取權限盤點 <small class="text-muted">（無外部存取則填 N/A）</small></div>
        <div class="card-body row g-3">
            <div class="col-md-4">
                <label asp-for="ExternalUnitName" class="form-label"></label>
                <input asp-for="ExternalUnitName" class="form-control" />
            </div>
            <div class="col-md-2">
                <label asp-for="HasLog" class="form-label"></label>
                <select asp-for="HasLog" class="form-select">
                    <option value="">請選擇</option>
                    <option>Y</option>
                    <option>N</option>
                    <option>N/A</option>
                </select>
            </div>
            <div class="col-md-2">
                <label asp-for="AccessCreate" class="form-label"></label>
                <input asp-for="AccessCreate" class="form-control" />
            </div>
            <div class="col-md-2">
                <label asp-for="AccessDelete" class="form-label"></label>
                <input asp-for="AccessDelete" class="form-control" />
            </div>
            <div class="col-md-2">
                <label asp-for="AccessCopy" class="form-label"></label>
                <input asp-for="AccessCopy" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="FileDescription" class="form-label"></label>
                <input asp-for="FileDescription" class="form-control" />
            </div>
            <div class="col-md-2">
                <label asp-for="SpecialData" class="form-label"></label>
                <input asp-for="SpecialData" class="form-control" />
            </div>
            <div class="col-md-2">
                <label asp-for="SubjectCount" class="form-label"></label>
                <input asp-for="SubjectCount" class="form-control" />
            </div>
            <div class="col-md-2">
                <label asp-for="RetentionPeriod" class="form-label"></label>
                <input asp-for="RetentionPeriod" class="form-control" />
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header fw-bold">IV. 備註</div>
        <div class="card-body">
            <textarea asp-for="Remark" class="form-control" rows="2"></textarea>
        </div>
    </div>

    <div class="mb-4">
        <button type="submit" class="btn btn-primary">@(isNew ? "新增" : "儲存")</button>
        <a class="btn btn-outline-secondary" asp-action="Index">取消</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
