        </dl>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header fw-bold bg-success text-white">資訊資產清單－資料(DA)</div>
    <div class="card-body pd-body">
        <dl class="pd-grid">
            <dt>@Html.DisplayNameFor(m => m.DaAssetCode)</dt><dd>@Model.DaAssetCode</dd>
            <dt>@Html.DisplayNameFor(m => m.DaAssetType)</dt><dd>@Model.DaAssetType</dd>
            <dt>@Html.DisplayNameFor(m => m.DaStatus)</dt><dd>@Model.DaStatus</dd>
            <dt class="pd-full">@Html.DisplayNameFor(m => m.DaDescription)</dt><dd class="pd-full" style="white-space: pre-wrap">@Model.DaDescription</dd>
            <dt>@Html.DisplayNameFor(m => m.DaBackupMethod)</dt><dd>@Model.DaBackupMethod</dd>
            <dt>@Html.DisplayNameFor(m => m.DaRetentionPeriod)</dt><dd>@Model.DaRetentionPeriod</dd>
            <dt>@Html.DisplayNameFor(m => m.DaHasSensitiveData)</dt><dd>@Model.DaHasSensitiveData</dd>
            <dt>@Html.DisplayNameFor(m => m.DaRiskOwner)</dt><dd>@Model.DaRiskOwner</dd>
            <dt>@Html.DisplayNameFor(m => m.DaLocation)</dt><dd>@Model.DaLocation</dd>
            <dt>@Html.DisplayNameFor(m => m.DaOwnerUnit)</dt><dd>@Model.DaOwnerUnit</dd>
            <dt>@Html.DisplayNameFor(m => m.DaCustodianUnit)</dt><dd>@Model.DaCustodianUnit</dd>
            <dt class="pd-full">@Html.DisplayNameFor(m => m.DaUserUnit)</dt><dd class="pd-full">@Model.DaUserUnit</dd>
            <dt>@Html.DisplayNameFor(m => m.DaConfidentiality)</dt><dd>@Model.DaConfidentiality</dd>
            <dt>@Html.DisplayNameFor(m => m.DaIntegrity)</dt><dd>@Model.DaIntegrity</dd>
            <dt>@Html.DisplayNameFor(m => m.DaAvailability)</dt><dd>@Model.DaAvailability</dd>
            <dt>@Html.DisplayNameFor(m => m.DaAssetValue)</dt><dd>@Model.DaAssetValue</dd>
            <dt>關連SW編號</dt><dd>@Model.SystemCode</dd>
            <dt>@Html.DisplayNameFor(m => m.DaBackupConfirm)</dt><dd>@Model.DaBackupConfirm</dd>
            <dt>@Html.DisplayNameFor(m => m.DaReviewer)</dt><dd>@Model.DaReviewer</dd>
            <dt>@Html.DisplayNameFor(m => m.DaModifiedTime)</dt><dd>@Model.DaModifiedTime</dd>
            <dt class="pd-full">@Html.DisplayNameFor(m => m.DaRemark)</dt><dd class="pd-full" style="white-space: pre-wrap">@Model.DaRemark</dd>
        </dl>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header fw-bold">I. 系統基本資訊</div>
    <div class="card-body pd-body">
        <dl class="pd-spec">
            <dt>@Html.DisplayNameFor(m => m.SystemCode)</dt>
            <dd>@Model.SystemCode</dd>
            <dt>@Html.DisplayNameFor(m => m.SystemName)</dt>
            <dd>@Model.SystemName</dd>
            <dt>@Html.DisplayNameFor(m => m.Description)</dt>
            <dd style="white-space: pre-wrap">@Model.Description</dd>
            <dt>@Html.DisplayNameFor(m => m.DbName)</dt>
            <dd style="white-space: pre-wrap">@Model.DbName</dd>
        </dl>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header fw-bold">II. 備份</div>
    <div class="card-body pd-body">
        <dl class="pd-spec">
            <dt>@Html.DisplayNameFor(m => m.BackupLocation)</dt>
            <dd style="white-space: pre-wrap">@Model.BackupLocation</dd>
            <dt>@Html.DisplayNameFor(m => m.BackupCycle)</dt>
            <dd>@Model.BackupCycle</dd>
        </dl>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header fw-bold">III. 外部單位存取權限盤點</div>
    <div class="card-body pd-body">
        <dl class="pd-spec">
            <dt>@Html.DisplayNameFor(m => m.ExternalUnitName)</dt>
            <dd>@Model.ExternalUnitName</dd>
            <dt>@Html.DisplayNameFor(m => m.HasLog)</dt>
            <dd>@Model.HasLog</dd>
            <dt>@Html.DisplayNameFor(m => m.AccessCreate)</dt>
            <dd>@Model.AccessCreate</dd>
            <dt>@Html.DisplayNameFor(m => m.AccessDelete)</dt>
            <dd>@Model.AccessDelete</dd>
            <dt>@Html.DisplayNameFor(m => m.AccessCopy)</dt>
            <dd>@Model.AccessCopy</dd>
            <dt>@Html.DisplayNameFor(m => m.FileDescription)</dt>
            <dd>@Model.FileDescription</dd>
            <dt>@Html.DisplayNameFor(m => m.SpecialData)</dt>
            <dd>@Model.SpecialData</dd>
            <dt>@Html.DisplayNameFor(m => m.SubjectCount)</dt>
            <dd>@Model.SubjectCount</dd>
            <dt>@Html.DisplayNameFor(m => m.RetentionPeriod)</dt>
            <dd>@Model.RetentionPeriod</dd>
        </dl>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header fw-bold">IV. 備註</div>
    <div class="card-body">
        <p class="mb-0">@Model.Remark</p>
    </div>
</div>
