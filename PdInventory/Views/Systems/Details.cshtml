@model PdInventory.Models.InfoSystem
@{
    ViewData["Title"] = $"系統 {Model.SeqNo}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>系統：@Model.SeqNo @Model.SystemCode @Model.SystemName</h2>
    <div>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id" asp-route-from="@ViewBag.From">編輯</a>
        <a class="btn btn-outline-secondary" asp-route-clear="1"
           asp-controller="@ViewBag.From" asp-action="Index">回列表</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header fw-bold bg-primary text-white">資訊資產清單－軟體(SW)</div>
    <div class="card-body pd-body">
        <dl class="pd-grid">
            <dt class="pd-full">資產說明</dt><dd class="pd-full" style="white-space: pre-wrap">@Model.DaDescription</dd>
            <dt>@Html.DisplayNameFor(m => m.SwStatus)</dt><dd>@Model.SwStatus</dd>
            <dt>@Html.DisplayNameFor(m => m.SwAssetType)</dt><dd>@Model.SwAssetType</dd>
            <dt>@Html.DisplayNameFor(m => m.SwSystemCategory)</dt><dd>@Model.SwSystemCategory</dd>
            <dt>@Html.DisplayNameFor(m => m.SwAdIntegration)</dt><dd>@Model.SwAdIntegration</dd>
            <dt>@Html.DisplayNameFor(m => m.SwOsVersion)</dt><dd>@Model.SwOsVersion</dd>
            <dt>@Html.DisplayNameFor(m => m.SwDbToolVersion)</dt><dd>@Model.SwDbToolVersion</dd>
            <dt class="pd-full">@Html.DisplayNameFor(m => m.SwThirdPartyComponents)</dt><dd class="pd-full" style="white-space: pre-wrap">@Model.SwThirdPartyComponents</dd>
            <dt>@Html.DisplayNameFor(m => m.SwUserAccountGrant)</dt><dd>@Model.SwUserAccountGrant</dd>
            <dt>@Html.DisplayNameFor(m => m.SwProvidesAccountReport)</dt><dd>@Model.SwProvidesAccountReport</dd>
            <dt>@Html.DisplayNameFor(m => m.SwRiskOwner)</dt><dd>@Model.SwRiskOwner</dd>
            <dt>@Html.DisplayNameFor(m => m.SwLocation)</dt><dd>@Model.SwLocation</dd>
            <dt>@Html.DisplayNameFor(m => m.SwOwnerUnit)</dt><dd>@Model.SwOwnerUnit</dd>
            <dt>@Html.DisplayNameFor(m => m.SwCustodianUnit)</dt><dd>@Model.SwCustodianUnit</dd>
            <dt class="pd-full">@Html.DisplayNameFor(m => m.SwUserUnit)</dt><dd class="pd-full">@Model.SwUserUnit</dd>
            <dt>@Html.DisplayNameFor(m => m.SwConfidentiality)</dt><dd>@Model.SwConfidentiality</dd>
            <dt>@Html.DisplayNameFor(m => m.SwIntegrity)</dt><dd>@Model.SwIntegrity</dd>
            <dt>@Html.DisplayNameFor(m => m.SwAvailability)</dt><dd>@Model.SwAvailability</dd>
            <dt>@Html.DisplayNameFor(m => m.SwAssetValue)</dt><dd>@Model.SwAssetValue</dd>
            <dt>@Html.DisplayNameFor(m => m.SwBusinessContact)</dt><dd>@Model.SwBusinessContact</dd>
            <dt>@Html.DisplayNameFor(m => m.SwAppManager)</dt><dd>@Model.SwAppManager</dd>
            <dt>@Html.DisplayNameFor(m => m.SwAppMaintainer)</dt><dd>@Model.SwAppMaintainer</dd>
            <dt>@Html.DisplayNameFor(m => m.SwAppMaintainerDeputy)</dt><dd>@Model.SwAppMaintainerDeputy</dd>
            <dt class="pd-full">@Html.DisplayNameFor(m => m.SwOperator)</dt><dd class="pd-full">@Model.SwOperator</dd>
            <dt>@Html.DisplayNameFor(m => m.SwDevMode)</dt><dd>@Model.SwDevMode</dd>
            <dt>@Html.DisplayNameFor(m => m.SwMaintMode)</dt><dd>@Model.SwMaintMode</dd>
            <dt>@Html.DisplayNameFor(m => m.SwVendor)</dt><dd>@Model.SwVendor</dd>
            <dt>@Html.DisplayNameFor(m => m.SwLanguage)</dt><dd>@Model.SwLanguage</dd>
            <dt>@Html.DisplayNameFor(m => m.SwVersionControl)</dt><dd>@Model.SwVersionControl</dd>
            <dt>@Html.DisplayNameFor(m => m.SwApRepoPath)</dt><dd>@Model.SwApRepoPath</dd>
            <dt>@Html.DisplayNameFor(m => m.SwDeployMethod)</dt><dd>@Model.SwDeployMethod</dd>
            <dt>@Html.DisplayNameFor(m => m.SwOpRepoPath)</dt><dd>@Model.SwOpRepoPath</dd>
            <dt>@Html.DisplayNameFor(m => m.SwCodeAccess)</dt><dd>@Model.SwCodeAccess</dd>
            <dt>@Html.DisplayNameFor(m => m.SwDeveloper)</dt><dd>@Model.SwDeveloper</dd>
            <dt>@Html.DisplayNameFor(m => m.SwDeployer)</dt><dd>@Model.SwDeployer</dd>
            <dt>@Html.DisplayNameFor(m => m.SwRpo)</dt><dd>@Model.SwRpo</dd>
            <dt>@Html.DisplayNameFor(m => m.SwLocalBackup)</dt><dd>@Model.SwLocalBackup</dd>
            <dt>@Html.DisplayNameFor(m => m.SwLocalBackupType)</dt><dd>@Model.SwLocalBackupType</dd>
            <dt>@Html.DisplayNameFor(m => m.SwLocalBackupFreq)</dt><dd>@Model.SwLocalBackupFreq</dd>
            <dt>@Html.DisplayNameFor(m => m.SwRemoteBackup)</dt><dd>@Model.SwRemoteBackup</dd>
            <dt>@Html.DisplayNameFor(m => m.SwRemoteBackupType)</dt><dd>@Model.SwRemoteBackupType</dd>
            <dt>@Html.DisplayNameFor(m => m.SwRemoteBackupFreq)</dt><dd>@Model.SwRemoteBackupFreq</dd>
            <dt>@Html.DisplayNameFor(m => m.SwLocalHa)</dt><dd>@Model.SwLocalHa</dd>
            <dt>@Html.DisplayNameFor(m => m.SwLocalHaArch)</dt><dd>@Model.SwLocalHaArch</dd>
            <dt>@Html.DisplayNameFor(m => m.SwRemoteHa)</dt><dd>@Model.SwRemoteHa</dd>
            <dt>@Html.DisplayNameFor(m => m.SwRemoteHaArch)</dt><dd>@Model.SwRemoteHaArch</dd>
            <dt>@Html.DisplayNameFor(m => m.SwRto)</dt><dd>@Model.SwRto</dd>
            <dt>@Html.DisplayNameFor(m => m.SwHasRecoveryPlan)</dt><dd>@Model.SwHasRecoveryPlan</dd>
            <dt>@Html.DisplayNameFor(m => m.SwHasDrDrill)</dt><dd>@Model.SwHasDrDrill</dd>
            <dt class="pd-full">@Html.DisplayNameFor(m => m.SwRelatedSystems)</dt><dd class="pd-full" style="white-space: pre-wrap">@Model.SwRelatedSystems</dd>
            <dt>@Html.DisplayNameFor(m => m.SwHandlesPersonalData)</dt><dd>@Model.SwHandlesPersonalData</dd>
            <dt>@Html.DisplayNameFor(m => m.SwHasUiAuth)</dt><dd>@Model.SwHasUiAuth</dd>
            <dt>@Html.DisplayNameFor(m => m.SwKeepsPdTrail)</dt><dd>@Model.SwKeepsPdTrail</dd>
            <dt>@Html.DisplayNameFor(m => m.SwProvidesApi)</dt><dd>@Model.SwProvidesApi</dd>
            <dt>@Html.DisplayNameFor(m => m.SwTrailLocation)</dt><dd>@Model.SwTrailLocation</dd>
            <dt>@Html.DisplayNameFor(m => m.SwTrailStorage)</dt><dd>@Model.SwTrailStorage</dd>
            <dt>@Html.DisplayNameFor(m => m.SwBusinessOwnerUnit)</dt><dd>@Model.SwBusinessOwnerUnit</dd>
            <dt>@Html.DisplayNameFor(m => m.SwIsCoreSystem)</dt><dd>@Model.SwIsCoreSystem</dd>
            <dt>@Html.DisplayNameFor(m => m.SwReviewer)</dt><dd>@Model.SwReviewer</dd>
            <dt>@Html.DisplayNameFor(m => m.SwModifiedBy)</dt><dd>@Model.SwModifiedBy</dd>
