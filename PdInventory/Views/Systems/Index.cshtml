@model List<PdInventory.Models.SystemInventory>
@{
    ViewData["Title"] = "資訊系統盤點表";
    // 編號、資產名稱、資產說明屬於軟體資產那一邊，由控制器補查後放進 ViewBag
    var assets = ViewBag.Assets as Dictionary<string, PdInventory.Models.InfoSystem>
                 ?? new Dictionary<string, PdInventory.Models.InfoSystem>();
    // 統一的檢視／編輯畫面以 DataAssets.Id 為主鍵，由控制器補查後放進 ViewBag
    var dataAssetIds = ViewBag.DataAssetIds as Dictionary<string, int>
                       ?? new Dictionary<string, int>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>資訊系統、資料庫與檔案伺服器盤點表 <small class="text-muted fs-6">(共 @Model.Count 套)</small></h2>
    @if (AssetAccess.CanCreate)
    {
        <a class="btn btn-primary" asp-controller="Data" asp-action="Create"
           asp-route-from="Systems">＋ 新增資訊資產</a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="q" value="@ViewBag.Query" class="form-control"
               placeholder="搜尋資產編號/資產名稱" style="min-width: 300px" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">搜尋</button>
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-clear="1">清除</a>
        <a class="btn btn-outline-success" asp-action="Export"
           asp-route-q="@ViewBag.Query">匯出 Excel</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover table-sm align-middle table-sortable pd-table">
        <thead class="table-dark">
            <tr>
                <th>編號</th>
                <th>資產編號</th>
                <th>資產名稱</th>
                <th style="max-width: 300px">SW-資產說明</th>
                <th style="max-width: 260px">資料庫/資料夾/檔案伺服器</th>
                <th>備份地點</th>
                <th>備份週期</th>
                <th style="min-width: 160px" data-nosort>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                var asset = assets.GetValueOrDefault(s.SystemCode);
                <tr>
                    <td>@asset?.SeqNo</td>
                    <td class="pd-code">@s.SystemCode</td>
                    <td>@asset?.SystemName</td>
                    <td class="text-break" style="max-width: 300px"><small>@asset?.SwDescription</small></td>
                    <td class="text-break" style="max-width: 260px"><small>@s.DbName</small></td>
                    <td class="text-break" style="max-width: 200px"><small>@s.BackupLocation</small></td>
                    <td><small>@s.BackupCycle</small></td>
                    @* 統一的檢視／編輯畫面以 DataAssets.Id 為主鍵 *@
                    @{ var dataId = dataAssetIds.GetValueOrDefault(s.SystemCode); }
                    <td>
                        @if (dataId > 0)
                        {
                            <a class="btn btn-sm btn-outline-info" asp-controller="Data" asp-action="Details"
                               asp-route-id="@dataId" asp-route-from="Systems">檢視</a>
                        }
                        @* 編輯與刪除鈕只出現在自己科別負責的資產上（能改就能刪） *@
                        @if (await AssetAccess.CanModifyAsync(s.SystemCode))
                        {
                            @if (dataId > 0)
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-controller="Data" asp-action="Edit"
                                   asp-route-id="@dataId" asp-route-from="Systems">編輯</a>
                            }
                            @* 只刪盤點表這一列，SW 與 DA 留著 *@
                            @if (await AssetAccess.CanDeleteAsync(s.SystemCode))
                            {
                                <form method="post" asp-action="Delete" asp-route-id="@s.Id" class="d-inline"
                                      data-delete-kind="盤點表資料" data-delete-name="@s.SystemCode"
                                      data-delete-mode="soft" data-delete-detail="只會刪除盤點表這一列，SW 與 DA 不受影響。">
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-confirm-delete>刪除</button>
                                </form>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
