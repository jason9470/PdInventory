@model List<PdInventory.Models.InfoSystem>
@{
    ViewData["Title"] = "資訊系統盤點表";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>資訊系統、資料庫與檔案伺服器盤點表 <small class="text-muted fs-6">(共 @Model.Count 套)</small></h2>
    <a class="btn btn-primary" asp-controller="Systems" asp-action="Create"
       asp-route-from="Systems">＋ 新增資訊資產</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="q" value="@ViewBag.Query" class="form-control"
               placeholder="搜尋資產編號/資產名稱" style="min-width: 300px" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">搜尋</button>
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-clear="1">清除</a>
        <a class="btn btn-outline-success" asp-action="Export"
           asp-route-q="@ViewBag.Query">匯出 Excel</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover table-sm align-middle table-sortable pd-table">
        <thead class="table-dark">
            <tr>
                <th>編號</th>
                <th>資產編號</th>
                <th>資產名稱</th>
                <th style="max-width: 300px">系統功能描述</th>
                <th style="max-width: 260px">資料庫/資料夾/檔案伺服器</th>
                <th>備份地點</th>
                <th>備份週期</th>
                <th style="min-width: 160px" data-nosort>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.SeqNo</td>
                    <td class="pd-code">@s.SystemCode</td>
                    <td>@s.SystemName</td>
                    <td class="text-break" style="max-width: 300px"><small>@s.Description</small></td>
                    <td class="text-break" style="max-width: 260px"><small>@s.DbName</small></td>
                    <td class="text-break" style="max-width: 200px"><small>@s.BackupLocation</small></td>
                    <td><small>@s.BackupCycle</small></td>
                    <td>
                        <a class="btn btn-sm btn-outline-info" asp-action="Details"
                           asp-route-id="@s.Id" asp-route-from="Systems">檢視</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit"
                           asp-route-id="@s.Id" asp-route-from="Systems">編輯</a>
                        <form method="post" asp-action="Delete" asp-route-id="@s.Id" class="d-inline"
                              onsubmit="return confirm('確定刪除系統「@s.SeqNo @s.SystemName」？');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">刪除</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
