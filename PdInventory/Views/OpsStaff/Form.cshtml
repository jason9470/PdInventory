@model PdInventory.Models.OpsStaff
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "新增維運人員" : $"編輯維運人員 {Model.Name}";
    var usedBy = (int)(ViewBag.UsedBy ?? 0);
}

<h2>@ViewData["Title"]</h2>

@if (usedBy > 0)
{
    <div class="alert alert-info">
        目前有 <strong>@usedBy</strong> 筆資產的維運人員或程式換版人員是「@Model.Name」。
        <strong>改名不會連帶更新那些資料</strong>——它們存的是文字，改完會變成選不到的舊值。
    </div>
}

<form method="post" asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.Id)" class="pd-form col-lg-9">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="TeamName" class="form-label"></label>
            <input asp-for="TeamName" class="form-control" placeholder="例：維運管理組" />
            <div class="form-text">甲方還沒給組別的可以留空。</div>
            <span asp-validation-for="TeamName" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="例：李長憬" />
            <div class="form-text">這個姓名就是「SW-維運人員」實際存的值，不可重複。</div>
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Remark" class="form-label"></label>
            <textarea asp-for="Remark" class="form-control" rows="2"></textarea>
        </div>
    </div>

    <div class="my-4">
        <button type="submit" class="btn btn-primary">@(isNew ? "新增" : "儲存")</button>
        <a class="btn btn-outline-secondary" asp-action="Index">取消</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
