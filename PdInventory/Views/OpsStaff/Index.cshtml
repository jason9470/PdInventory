@model List<PdInventory.Models.OpsStaff>
@{
    ViewData["Title"] = "資管維運";
    var pending = Model.Count(o => string.IsNullOrWhiteSpace(o.TeamName));
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>資管維運 <small class="text-muted fs-6">(共 @Model.Count 人)</small></h2>
    <a class="btn btn-primary" asp-action="Create">＋ 新增維運人員</a>
</div>

<p class="text-muted small">對照欄位：SW-維運人員（多選）。</p>

@if (pending > 0)
{
    <div class="alert alert-warning">
        有 <strong>@pending</strong> 筆沒有組別——這些是既有資料裡出現過、
        但不在甲方名單中的人，先建進來把值留住，組別待甲方補齊。它們排在清單最後。
    </div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="q" value="@ViewBag.Query" class="form-control"
               placeholder="搜尋組別/姓名/備註" style="min-width: 320px" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">搜尋</button>
        <a class="btn btn-outline-secondary" asp-action="Index">清除</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover table-sm align-middle pd-table">
        <thead class="table-dark">
            <tr>
                <th style="min-width: 140px">組別</th>
                <th style="min-width: 140px">姓名</th>
                <th style="min-width: 240px">備註</th>
                <th style="min-width: 120px" data-nosort>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td>
                        @if (string.IsNullOrWhiteSpace(o.TeamName))
                        {
                            <span class="badge text-bg-warning">待補</span>
                        }
                        else
                        {
                            @o.TeamName
                        }
                    </td>
                    <td>@o.Name</td>
                    <td class="text-break"><small>@o.Remark</small></td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@o.Id">編輯</a>
                        <form method="post" asp-action="Delete" asp-route-id="@o.Id" class="d-inline"
                              onsubmit="return confirm('確定刪除維運人員「@o.Name」？');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">刪除</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
