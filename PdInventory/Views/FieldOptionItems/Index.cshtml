@model List<PdInventory.Models.FieldOptionItem>
@{
    var field = (PdInventory.Helpers.OptionField)ViewBag.Field;
    var usage = (Dictionary<string, int>)ViewBag.UsageCounts;
    ViewData["Title"] = field.Title;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>
        @field.Title
        <small class="text-muted fs-6">(@field.ModeLabel，共 @Model.Count 個選項)</small>
    </h2>
</div>

<p class="text-muted small">
    這裡的選項就是該欄位下拉裡看到的內容，<strong>順序也會照這裡的順序</strong>。
    @if (field.IsMultiple)
    {
        <text>這是多選欄位，同一格可以選多個，存進資料庫時以「@PdInventory.Helpers.MultiValue.Separator」分隔。</text>
    }
</p>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="table-responsive">
            <table class="table table-striped table-hover table-sm align-middle pd-table">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 90px" data-nosort>順序</th>
                        <th style="min-width: 200px">選項</th>
                        <th style="width: 110px">使用中</th>
                        <th style="min-width: 200px">備註</th>
                        <th style="width: 90px" data-nosort>操作</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Count; i++)
                    {
                        var item = Model[i];
                        var used = usage.GetValueOrDefault(item.Value);
                        <tr>
                            <td class="text-nowrap">
                                <form method="post" asp-action="Move" asp-route-id="@item.Id" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="delta" value="-1" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-1"
                                            title="上移" disabled="@(i == 0)">▲</button>
                                </form>
                                <form method="post" asp-action="Move" asp-route-id="@item.Id" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="delta" value="1" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-1"
                                            title="下移" disabled="@(i == Model.Count - 1)">▼</button>
                                </form>
                            </td>
                            <td class="text-break fw-semibold">@item.Value</td>
                            <td>
                                @if (used > 0)
                                {
                                    <span class="badge text-bg-primary">@used 筆</span>
                                }
                                else
                                {
                                    <span class="text-muted small">未使用</span>
                                }
                            </td>
                            <td>
                                <form method="post" asp-action="Edit" asp-route-id="@item.Id"
                                      class="d-flex gap-1">
                                    @Html.AntiForgeryToken()
                                    <input name="remark" value="@item.Remark" class="form-control form-control-sm"
                                           placeholder="備註" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">存</button>
                                </form>
                            </td>
                            <td>
                                <form method="post" asp-action="Delete" asp-route-id="@item.Id" class="d-inline"
                                      onsubmit="return confirm('確定刪除選項「@item.Value」？');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            disabled="@(used > 0)"
                                            title="@(used > 0 ? "還被資料使用中，不能刪除" : "刪除")">刪除</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="5" class="text-muted text-center py-3">還沒有任何選項。</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header py-2 fw-bold small">新增選項</div>
            <div class="card-body pd-form">
                <form method="post" asp-action="Create">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="field" value="@field.Field" />
                    <div class="mb-3">
                        <label class="form-label" for="value">選項</label>
                        <input id="value" name="value" class="form-control" required />
                        <div class="form-text">
                            這就是欄位裡實際存的文字。
                            @if (field.IsMultiple)
                            {
                                <text>不能包含「@PdInventory.Helpers.MultiValue.Separator」，那是分隔符號。</text>
                            }
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="remark">備註</label>
                        <input id="remark" name="remark" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">新增</button>
                </form>
            </div>
        </div>

        <div class="alert alert-secondary small mt-3 mb-0">
            <strong>選項的值不能修改</strong>，只能新增或刪除。
            各表單存的是文字而不是編號，在這裡改字不會連帶更新那些資料，
            只會讓它們變成選不到的舊值。要改字請新增正確的選項、把資料改過去，再刪掉舊的。
            <br />
            還在使用中的選項不能刪除，「使用中」那一欄看得到有幾筆在用。
        </div>
    </div>
</div>
