{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // 身分來源。
  // Mode = Simulated：登入頁自行挑選身分、不驗證密碼（權限測試用）。
  // Mode = Ldap     ：帳號密碼交給公司 AD 驗證，登入頁會出現密碼欄。
  //
  // Ldap 區段的值請洽網域管理者確認；下列預設值是依 AD 範例 DN 推得，尚未在公司網內實測：
  //   LDAP://brk.corp.yuanta.com/CN=183253 [林子耕],OU=10500,OU=HQ,OU=6010H,DC=brk,DC=corp,DC=yuanta,DC=com
  "Employee": {
    "Mode": "Simulated",
    "Ldap": {
      "Host": "brk.corp.yuanta.com",
      "Port": 636,
      "UseSsl": true,
      "Domain": "brk.corp.yuanta.com",
      "BaseDn": "DC=brk,DC=corp,DC=yuanta,DC=com",
      "AccountAttribute": "sAMAccountName",
      "RequiredGroupDn": "",
      "EmpNoLength": 7,
      "AuthType": "Negotiate",
      "TimeoutSeconds": 10
    }
  }
}
